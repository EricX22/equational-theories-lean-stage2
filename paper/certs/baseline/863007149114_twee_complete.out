  f(f(f(f(f(f(X, f(Y, f(Y, X))), X), W), f(f(Y, f(W, X)), f(f(f(X, f(Y, f(Y, X))), X), W))), f(f(f(Y, f(W, X)), f(f(f(X, f(Y, f(Y, X))), X), W)), f(f(f(Y, f(W, X)), f(f(f(X, f(Y, f(Y, X))), X), W)), f(f(f(f(X, f(Y, f(Y, X))), X), W), f(f(f(f(f(X, f(Y, f(Y, X))), X), f(f(f(Y, f(W, X)), f(f(f(X, f(Y, f(Y, X))), X), W)), f(f(X, f(Y, f(Y, X))), X))), f(f(f(f(Y, f(W, X)), f(f(f(X, f(Y, f(Y, X))), X), W)), f(f(X, f(Y, f(Y, X))), X)), f(f(f(f(Y, f(W, X)), f(f(f(X, f(Y, f(Y, X))), X), W)), f(f(X, f(Y, f(Y, X))), X)), f(f(f(X, f(Y, f(Y, X))), X), f(f(f(Y, f(W, X)), f(f(f(X, f(Y, f(Y, X))), X), W)), f(f(X, f(Y, f(Y, X))), X)))))), f(f(f(X, f(Y, f(Y, X))), X), f(f(f(Y, f(W, X)), f(f(f(X, f(Y, f(Y, X))), X), W)), f(f(X, f(Y, f(Y, X))), X)))))))), f(f(f(f(X, f(Y, f(Y, X))), X), f(f(f(Y, f(W, X)), f(f(f(X, f(Y, f(Y, X))), X), W)), f(f(X, f(Y, f(Y, X))), X))), f(f(Y, f(W, X)), f(f(f(X, f(Y, f(Y, X))), X), W))))
= { by lemma 4 }
  f(f(f(f(f(f(X, f(Y, f(Y, X))), X), W), f(f(Y, f(W, X)), f(f(f(X, f(Y, f(Y, X))), X), W))), f(f(f(Y, f(W, X)), f(f(f(X, f(Y, f(Y, X))), X), W)), f(f(f(Y, f(W, X)), f(f(f(X, f(Y, f(Y, X))), X), W)), f(f(f(f(X, f(Y, f(Y, X))), X), W), f(f(f(f(f(X, f(Y, f(Y, X))), X), f(f(f(Y, f(W, X)), f(f(f(X, f(Y, f(Y, X))), X), W)), f(f(X, f(Y, f(Y, X))), X))), f(f(f(f(Y, f(W, X)), f(f(f(X, f(Y, f(Y, X))), X), W)), f(f(X, f(Y, f(Y, X))), X)), f(f(f(f(Y, f(W, X)), f(f(f(X, f(Y, f(Y, X))), X), W)), f(f(X, f(Y, f(Y, X))), X)), f(f(f(X, f(Y, f(Y, X))), X), f(f(f(Y, f(W, X)), f(f(f(X, f(Y, f(Y, X))), X), W)), f(f(X, f(Y, f(Y, X))), X)))))), f(f(f(X, f(Y, f(Y, X))), X), f(f(f(Y, f(W, X)), f(f(f(X, f(Y, f(Y, X))), X), W)), f(f(X, f(Y, f(Y, X))), X)))))))), f(f(f(f(X, f(Y, f(Y, X))), X), W), f(f(Y, f(W, X)), f(f(f(X, f(Y, f(Y, X))), X), W))))
= { by lemma 11 }
  f(Y, f(W, X))

Lemma 16: f(f(X, V), f(Z, f(V, W))) = f(f(X, Y), f(Z, f(Y, W))).
Proof:
  f(f(X, V), f(Z, f(V, W)))
= { by lemma 15 R->L }
  f(f(X, V), f(f(f(f(W, f(Z, f(Z, W))), W), U), f(V, f(U, f(f(f(W, f(Z, f(Z, W))), W), U)))))
= { by axiom 1 (hyp) }
  f(f(X, V), f(f(f(f(W, f(Z, f(Z, W))), W), U), f(V, f(U, f(f(f(f(U, T), f(f(f(f(W, f(Z, f(Z, W))), W), U), f(T, f(U, S)))), f(U, f(f(f(W, f(Z, f(Z, W))), W), U))), U)))))
= { by axiom 1 (hyp) }
  f(f(X, V), f(f(f(f(f(U, T), f(f(f(f(W, f(Z, f(Z, W))), W), U), f(T, f(U, S)))), f(U, f(f(f(W, f(Z, f(Z, W))), W), U))), U), f(V, f(U, f(f(f(f(U, T), f(f(f(f(W, f(Z, f(Z, W))), W), U), f(T, f(U, S)))), f(U, f(f(f(W, f(Z, f(Z, W))), W), U))), U)))))
= { by lemma 14 }
  f(f(X, V), f(f(f(f(f(U, T), f(f(f(f(W, f(Z, f(Z, W))), W), U), f(T, f(U, S)))), f(U, f(f(f(W, f(Z, f(Z, W))), W), U))), X), f(V, f(X, f(f(f(f(U, T), f(f(f(f(W, f(Z, f(Z, W))), W), U), f(T, f(U, S)))), f(U, f(f(f(W, f(Z, f(Z, W))), W), U))), Y2)))))
= { by lemma 14 }
  f(f(X, Y), f(f(f(f(f(U, T), f(f(f(f(W, f(Z, f(Z, W))), W), U), f(T, f(U, S)))), f(U, f(f(f(W, f(Z, f(Z, W))), W), U))), X), f(Y, f(X, f(f(f(f(U, T), f(f(f(f(W, f(Z, f(Z, W))), W), U), f(T, f(U, S)))), f(U, f(f(f(W, f(Z, f(Z, W))), W), U))), X2)))))
= { by lemma 14 R->L }
  f(f(X, Y), f(f(f(f(f(U, T), f(f(f(f(W, f(Z, f(Z, W))), W), U), f(T, f(U, S)))), f(U, f(f(f(W, f(Z, f(Z, W))), W), U))), U), f(Y, f(U, f(f(f(f(U, T), f(f(f(f(W, f(Z, f(Z, W))), W), U), f(T, f(U, S)))), f(U, f(f(f(W, f(Z, f(Z, W))), W), U))), U)))))
= { by axiom 1 (hyp) R->L }
  f(f(X, Y), f(f(f(f(W, f(Z, f(Z, W))), W), U), f(Y, f(U, f(f(f(f(U, T), f(f(f(f(W, f(Z, f(Z, W))), W), U), f(T, f(U, S)))), f(U, f(f(f(W, f(Z, f(Z, W))), W), U))), U)))))
= { by axiom 1 (hyp) R->L }
  f(f(X, Y), f(f(f(f(W, f(Z, f(Z, W))), W), U), f(Y, f(U, f(f(f(W, f(Z, f(Z, W))), W), U)))))
= { by lemma 15 }
  f(f(X, Y), f(Z, f(Y, W)))

Lemma 17: f(f(X, U), f(f(Z, T), f(U, f(T, S)))) = f(f(X, Y), f(f(Z, W), f(Y, f(W, V)))).
Proof:
  f(f(X, U), f(f(Z, T), f(U, f(T, S))))
= { by lemma 16 }
  f(f(X, U), f(f(Z, X), f(U, f(X, S))))
= { by lemma 14 }
  f(f(X, Y), f(f(Z, X), f(Y, f(X, V))))
= { by lemma 16 R->L }
  f(f(X, Y), f(f(Z, W), f(Y, f(W, V))))

Lemma 18: f(f(X, f(f(X, Y), f(f(f(Z, f(X, W)), X), f(Y, f(X, V))))), X) = f(f(X, Z), X).
Proof:
  f(f(X, f(f(X, Y), f(f(f(Z, f(X, W)), X), f(Y, f(X, V))))), X)
= { by lemma 2 R->L }
  f(f(X, f(f(X, Y), f(f(f(Z, f(X, W)), X), f(Y, f(X, V))))), f(f(f(f(f(Z, f(X, W)), X), f(X, f(X, f(f(Z, f(X, W)), X)))), f(f(Z, f(X, W)), X)), f(f(f(X, Y), f(f(f(Z, f(X, W)), X), f(Y, f(X, V)))), f(X, f(f(Z, f(X, W)), X)))))
= { by lemma 14 R->L }
  f(f(X, Z), f(f(f(f(f(Z, f(X, W)), X), f(X, f(X, f(f(Z, f(X, W)), X)))), f(f(Z, f(X, W)), X)), f(Z, f(X, W))))
= { by axiom 1 (hyp) R->L }
  f(f(X, Z), X)

Lemma 19: f(f(f(X, Y), f(f(Z, W), f(Y, f(W, V)))), f(X, f(Z, X))) = Z.
Proof:
  f(f(f(X, Y), f(f(Z, W), f(Y, f(W, V)))), f(X, f(Z, X)))
= { by lemma 17 }
  f(f(f(X, U), f(f(Z, X), f(U, f(X, T)))), f(X, f(Z, X)))
= { by lemma 11 }
  Z

Lemma 20: f(X, f(f(X, Y), f(f(f(Z, f(X, W)), X), f(Y, f(X, V))))) = f(X, Z).
Proof:
  f(X, f(f(X, Y), f(f(f(Z, f(X, W)), X), f(Y, f(X, V)))))
= { by lemma 11 R->L }
  f(f(f(X, U), f(f(f(X, f(f(X, Y), f(f(f(Z, f(X, W)), X), f(Y, f(X, V))))), X), f(U, f(X, T)))), f(X, f(f(X, f(f(X, Y), f(f(f(Z, f(X, W)), X), f(Y, f(X, V))))), X)))
= { by lemma 18 }
  f(f(f(X, U), f(f(f(X, Z), X), f(U, f(X, T)))), f(X, f(f(X, f(f(X, Y), f(f(f(Z, f(X, W)), X), f(Y, f(X, V))))), X)))
= { by lemma 18 }
  f(f(f(X, U), f(f(f(X, Z), X), f(U, f(X, T)))), f(X, f(f(X, Z), X)))
= { by lemma 19 }
  f(X, Z)

Lemma 21: f(f(X, f(Y, Z)), f(W, f(f(Y, V), f(X, f(V, f(Y, U)))))) = f(f(X, T), f(W, f(T, f(X, S)))).
Proof:
  f(f(X, f(Y, Z)), f(W, f(f(Y, V), f(X, f(V, f(Y, U))))))
= { by lemma 14 }
  f(f(X, f(Y, Z)), f(W, f(f(Y, Z), f(X, f(Z, f(Y, X2))))))
= { by lemma 14 R->L }
  f(f(X, T), f(W, f(T, f(X, S))))

Lemma 22: f(f(X, Y), f(Z, f(f(f(X, W), V), f(X, f(V, U))))) = f(f(X, T), f(Z, f(T, f(X, S)))).
Proof:
  f(f(X, Y), f(Z, f(f(f(X, W), V), f(X, f(V, U)))))
= { by lemma 12 R->L }
  f(f(X, Y), f(f(f(f(f(X, f(f(f(f(X, f(X, f(X, X))), f(f(X, X), X)), X), f(f(X, f(X, f(X, X))), f(f(X, f(X, f(X, X))), X)))), f(Z, f(f(X, f(X, f(X, X))), X))), f(X, Z)), X), f(f(f(X, W), V), f(X, f(V, U)))))
= { by lemma 17 }
  f(f(X, Y), f(f(f(f(f(X, f(f(f(f(X, f(X, f(X, X))), f(f(X, X), X)), X), f(f(X, f(X, f(X, X))), f(f(X, f(X, f(X, X))), X)))), f(Z, f(f(X, f(X, f(X, X))), X))), f(X, Z)), X), f(f(f(X, W), X2), f(X, f(X2, f(f(X, W), Y2))))))
= { by lemma 12 }
  f(f(X, Y), f(Z, f(f(f(X, W), X2), f(X, f(X2, f(f(X, W), Y2))))))
= { by lemma 20 R->L }
  f(f(X, f(f(X, W), f(f(f(Y, f(X, Z2)), X), f(W, f(X, W2))))), f(Z, f(f(f(X, W), X2), f(X, f(X2, f(f(X, W), Y2))))))
= { by lemma 21 }
  f(f(X, T), f(Z, f(T, f(X, S))))

Lemma 23: f(f(f(X, Y), Z), f(W, f(Z, f(f(X, Y), V)))) = f(f(f(X, Y), X), f(W, f(X, U))).
Proof:
  f(f(f(X, Y), Z), f(W, f(Z, f(f(X, Y), V))))
= { by lemma 14 }
  f(f(f(X, Y), X), f(W, f(X, f(f(X, Y), f(f(f(U, f(X, T)), X), f(Y, f(X, S)))))))
= { by lemma 20 }
  f(f(f(X, Y), X), f(W, f(X, U)))

Lemma 24: f(f(f(X, Y), f(f(f(X, Z), X), f(Y, f(X, W)))), f(V, f(X, U))) = f(f(f(X, Z), X), f(V, f(X, T))).
Proof:
  f(f(f(X, Y), f(f(f(X, Z), X), f(Y, f(X, W)))), f(V, f(X, U)))
= { by lemma 22 R->L }
  f(f(f(X, Z), f(f(f(X, Z), X), f(f(f(X, U), f(X, Z)), f(X, f(f(X, Z), S))))), f(V, f(X, U)))
= { by lemma 11 R->L }
  f(f(f(X, Z), f(f(f(X, Z), X), f(f(f(X, U), f(X, Z)), f(X, f(f(X, Z), S))))), f(V, f(f(f(f(X, Z), X), f(f(f(X, U), f(X, Z)), f(X, f(f(X, Z), S)))), f(f(X, Z), f(f(X, U), f(X, Z))))))
= { by lemma 23 }
  f(f(f(X, Z), X), f(V, f(X, T)))

Lemma 25: f(f(X, Y), f(f(f(X, Z), X), f(Y, f(X, W)))) = f(f(X, Z), X).
Proof:
  f(f(X, Y), f(f(f(X, Z), X), f(Y, f(X, W))))
= { by lemma 11 R->L }
  f(f(f(f(V, f(X, U)), T), f(f(f(f(X, Y), f(f(f(X, Z), X), f(Y, f(X, W)))), f(V, f(X, U))), f(T, f(f(V, f(X, U)), S)))), f(f(V, f(X, U)), f(f(f(X, Y), f(f(f(X, Z), X), f(Y, f(X, W)))), f(V, f(X, U)))))
= { by lemma 24 }
  f(f(f(f(V, f(X, U)), T), f(f(f(f(X, Z), X), f(V, f(X, U))), f(T, f(f(V, f(X, U)), S)))), f(f(V, f(X, U)), f(f(f(X, Y), f(f(f(X, Z), X), f(Y, f(X, W)))), f(V, f(X, U)))))
= { by lemma 24 }
  f(f(f(f(V, f(X, U)), T), f(f(f(f(X, Z), X), f(V, f(X, U))), f(T, f(f(V, f(X, U)), S)))), f(f(V, f(X, U)), f(f(f(X, Z), X), f(V, f(X, U)))))
= { by lemma 19 }
  f(f(X, Z), X)

Lemma 26: f(f(X, Y), f(f(X, X), f(Y, f(X, Z)))) = f(f(X, W), f(f(X, V), X)).
Proof:
  f(f(X, Y), f(f(X, X), f(Y, f(X, Z))))
= { by lemma 22 R->L }
  f(f(X, W), f(f(X, X), f(f(f(X, V), X), f(X, f(X, U)))))
= { by lemma 25 }
  f(f(X, W), f(f(X, V), X))

Lemma 27: f(f(X, f(f(X, Y), X)), f(f(X, Y), X)) = f(f(X, Z), f(f(X, W), X)).
Proof:
  f(f(X, f(f(X, Y), X)), f(f(X, Y), X))
= { by lemma 25 R->L }
  f(f(X, f(f(X, Y), X)), f(f(X, X), f(f(f(X, Y), X), f(X, f(X, V)))))
= { by lemma 26 }
  f(f(X, Z), f(f(X, W), X))

Lemma 28: f(X, f(f(X, Y), X)) = f(X, Z).
Proof:
  f(X, f(f(X, Y), X))
= { by lemma 11 R->L }
  f(f(f(f(f(X, Y), X), W), f(f(f(X, f(f(X, Y), X)), f(f(X, Y), X)), f(W, f(f(f(X, Y), X), V)))), f(f(f(X, Y), X), f(f(X, f(f(X, Y), X)), f(f(X, Y), X))))
= { by lemma 27 }
  f(f(f(f(f(X, Y), X), W), f(f(f(X, Z), f(f(X, Y), X)), f(W, f(f(f(X, Y), X), V)))), f(f(f(X, Y), X), f(f(X, f(f(X, Y), X)), f(f(X, Y), X))))
= { by lemma 27 }
  f(f(f(f(f(X, Y), X), W), f(f(f(X, Z), f(f(X, Y), X)), f(W, f(f(f(X, Y), X), V)))), f(f(f(X, Y), X), f(f(X, Z), f(f(X, Y), X))))
= { by lemma 19 }
  f(X, Z)

Lemma 29: f(f(f(X, Y), X), f(X, Z)) = f(X, Y).
Proof:
  f(f(f(X, Y), X), f(X, Z))
= { by lemma 25 R->L }
  f(f(f(X, W), f(f(f(X, Y), X), f(W, f(X, V)))), f(X, Z))
= { by lemma 28 R->L }
  f(f(f(X, W), f(f(f(X, Y), X), f(W, f(X, V)))), f(X, f(f(X, Y), X)))
= { by lemma 11 }
  f(X, Y)

Lemma 30: f(f(X, Y), f(Z, f(Y, f(X, W)))) = f(f(X, V), f(Z, f(X, U))).
Proof:
  f(f(X, Y), f(Z, f(Y, f(X, W))))
= { by lemma 14 }
  f(f(X, f(f(X, U), X)), f(Z, f(f(f(X, U), X), f(X, T))))
= { by lemma 29 }
  f(f(X, f(f(X, U), X)), f(Z, f(X, U)))
= { by lemma 28 }
  f(f(X, V), f(Z, f(X, U)))

Lemma 31: f(X, f(Y, f(Y, Z))) = f(X, f(Y, Y)).
Proof:
  f(X, f(Y, f(Y, Z)))
= { by axiom 1 (hyp) }
  f(f(f(f(f(Y, Y), Y), f(f(X, f(Y, f(Y, Z))), f(Y, f(f(Y, Y), W)))), f(f(Y, Y), f(X, f(Y, f(Y, Z))))), f(Y, Y))
= { by lemma 30 }
  f(f(f(f(f(Y, Y), Y), f(f(X, f(Y, f(Y, Z))), f(Y, f(f(Y, Y), W)))), f(f(Y, Y), f(X, f(Y, Y)))), f(Y, Y))
= { by lemma 23 R->L }
  f(f(f(f(f(Y, Y), V), f(f(X, f(Y, f(Y, Z))), f(V, f(f(Y, Y), f(X, f(Y, f(Y, U))))))), f(f(Y, Y), f(X, f(Y, Y)))), f(Y, Y))
= { by lemma 21 }
  f(f(f(f(f(Y, Y), V), f(f(X, T), f(V, f(T, f(X, S))))), f(f(Y, Y), f(X, f(Y, Y)))), f(Y, Y))
= { by lemma 19 }
  f(X, f(Y, Y))

Lemma 32: f(f(X, f(Y, Z)), f(Y, W)) = f(f(X, V), f(Y, f(V, Y))).
Proof:
  f(f(X, f(Y, Z)), f(Y, W))
= { by lemma 28 R->L }
  f(f(X, f(Y, Z)), f(Y, f(f(Y, Z), Y)))
= { by lemma 16 R->L }
  f(f(X, V), f(Y, f(V, Y)))

Lemma 33: f(f(X, Y), X) = X.
Proof:
