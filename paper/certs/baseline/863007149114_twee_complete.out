  f(f(X, f(Y, f(Y, X))), X)
= { by axiom 1 (hyp) }
  f(f(f(f(Y, f(f(Y, Z), f(X, f(Z, f(Y, W))))), f(f(f(X, f(Y, f(Y, X))), X), f(f(f(Y, Z), f(X, f(Z, f(Y, W)))), f(Y, X)))), f(Y, f(f(X, f(Y, f(Y, X))), X))), Y)
= { by lemma 2 }
  f(f(f(f(Y, f(f(Y, Z), f(X, f(Z, f(Y, W))))), Y), f(Y, f(f(X, f(Y, f(Y, X))), X))), Y)
= { by lemma 34 }
  f(f(f(f(Y, f(f(Y, Z), f(X, Z))), Y), f(Y, f(f(X, f(Y, f(Y, X))), X))), Y)
= { by lemma 34 }
  f(f(f(f(Y, f(Y, f(X, Z))), Y), f(Y, f(f(X, f(Y, f(Y, X))), X))), Y)
= { by lemma 34 }
  f(f(f(Y, Y), f(Y, f(f(X, f(Y, f(Y, X))), X))), Y)
= { by lemma 34 }
  f(f(Y, f(Y, f(f(X, f(Y, f(Y, X))), X))), Y)
= { by lemma 34 }
  f(Y, Y)
= { by lemma 34 }
  Y

Lemma 36: f(X, Y) = Y.
Proof:
  f(X, Y)
= { by lemma 11 R->L }
  f(f(f(X, Y), f(f(f(X, Y), X), f(Y, f(X, Z)))), f(X, f(f(X, Y), X)))
= { by lemma 35 }
  f(f(f(X, Y), f(Y, f(Y, f(X, Z)))), f(X, f(f(X, Y), X)))
= { by lemma 34 }
  f(f(f(X, Y), Y), f(X, f(f(X, Y), X)))
= { by lemma 35 }
  f(f(f(X, Y), Y), f(X, Y))
= { by lemma 35 }
  Y

Goal 1 (goal): x = y.
Proof:
  x
= { by lemma 36 R->L }
  f(f(f(x, f(y, f(X, Y))), f(x, y)), x)
= { by lemma 36 R->L }
  f(f(f(x, f(y, f(X, Y))), f(x, y)), f(f(x, f(Y, f(Y, x))), x))
= { by lemma 36 R->L }
  f(f(f(x, f(y, f(X, Y))), f(f(f(x, f(Y, f(Y, x))), x), y)), f(f(x, f(Y, f(Y, x))), x))
= { by lemma 34 R->L }
  f(f(f(f(x, X), f(y, f(X, Y))), f(f(f(x, f(Y, f(Y, x))), x), y)), f(f(x, f(Y, f(Y, x))), x))
= { by lemma 36 R->L }
  f(f(f(f(f(f(x, f(Y, f(Y, x))), x), X), f(y, f(X, Y))), f(f(f(x, f(Y, f(Y, x))), x), y)), f(f(x, f(Y, f(Y, x))), x))
= { by lemma 3 }
  y
% SZS output end Proof

RESULT: Theorem (the conjecture is true).
