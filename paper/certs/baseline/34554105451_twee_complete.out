  f(f(X, f(X, X)), f(f(f(f(Y, f(X, X)), f(X, X)), x), f(f(X, f(X, X)), f(X, X))))
= { by lemma 19 }
  f(f(X, f(X, X)), f(f(X, f(X, X)), f(X, X)))
= { by lemma 19 R->L }
  f(f(X, f(X, X)), f(f(f(f(Z, f(X, X)), f(X, X)), y), f(f(X, f(X, X)), f(X, X))))
= { by lemma 19 R->L }
  f(f(X, f(X, X)), f(f(f(f(Z, f(X, X)), f(X, X)), y), f(f(X, f(X, X)), f(f(X, f(X, X)), f(X, X)))))
= { by lemma 19 R->L }
  f(f(X, f(X, X)), f(f(f(f(Z, f(X, X)), f(X, X)), y), f(f(X, f(X, X)), f(y, f(f(X, f(X, X)), f(X, X))))))
= { by axiom 1 (hyp) R->L }
  y
% SZS output end Proof

RESULT: Theorem (the conjecture is true).
