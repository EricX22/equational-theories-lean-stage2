  f(f(f(T, f(f(W, f(V, U)), T)), f(f(f(Y, f(Y, Y)), f(f(S, f(X, Y)), Y)), f(f(W, f(V, U)), f(f(Y, f(Y, Y)), f(f(S, f(X, Y)), Y))))), f(f(f(Y, f(Y, Y)), f(f(S, f(X, Y)), Y)), f(T, f(f(f(Y, f(Y, Y)), f(f(S, f(X, Y)), Y)), f(f(f(f(Z, f(W, f(V, U))), f(U, f(Z, f(W, f(V, U))))), f(V, U)), f(f(Y, f(Y, Y)), f(f(S, f(X, Y)), Y)))))))
= { by lemma 8 }
  f(f(f(T, f(f(W, f(V, U)), T)), f(f(f(Y, f(Y, Y)), f(f(S, f(X, Y)), Y)), f(f(W, f(V, U)), f(f(Y, f(Y, Y)), f(f(S, f(X, Y)), Y))))), f(f(f(Y, f(Y, Y)), f(f(S, f(X, Y)), Y)), f(T, f(f(f(Y, f(Y, Y)), f(f(S, f(X, Y)), Y)), f(f(W, f(V, U)), f(f(Y, f(Y, Y)), f(f(S, f(X, Y)), Y)))))))
= { by lemma 4 }
  f(f(X, Y), f(W, f(V, U)))

Lemma 10: f(Z, Y) = f(X, Y).
Proof:
  f(Z, Y)
= { by axiom 1 (hyp) }
  f(Z, f(f(W, V), f(f(Y, f(V, Y)), f(f(U, f(W, Y)), V))))
= { by lemma 3 R->L }
  f(f(f(f(Y, f(V, Y)), f(f(f(W, V), f(f(Y, f(V, Y)), f(f(U, f(W, Y)), V))), f(Y, f(V, Y)))), f(f(U, f(W, Y)), V)), f(f(f(Z, f(f(W, V), f(f(Y, f(V, Y)), f(f(U, f(W, Y)), V)))), f(f(f(U, f(W, Y)), V), f(Z, f(f(W, V), f(f(Y, f(V, Y)), f(f(U, f(W, Y)), V)))))), f(f(Y, f(V, Y)), f(f(U, f(W, Y)), V))))
= { by lemma 9 }
  f(f(f(f(Y, f(V, Y)), f(f(f(W, V), f(f(Y, f(V, Y)), f(f(U, f(W, Y)), V))), f(Y, f(V, Y)))), f(f(U, f(W, Y)), V)), f(f(W, V), f(f(Y, f(V, Y)), f(f(U, f(W, Y)), V))))
= { by lemma 9 R->L }
  f(f(f(f(Y, f(V, Y)), f(f(f(W, V), f(f(Y, f(V, Y)), f(f(U, f(W, Y)), V))), f(Y, f(V, Y)))), f(f(U, f(W, Y)), V)), f(f(f(X, f(f(W, V), f(f(Y, f(V, Y)), f(f(U, f(W, Y)), V)))), f(f(f(U, f(W, Y)), V), f(X, f(f(W, V), f(f(Y, f(V, Y)), f(f(U, f(W, Y)), V)))))), f(f(Y, f(V, Y)), f(f(U, f(W, Y)), V))))
= { by lemma 3 }
  f(X, f(f(W, V), f(f(Y, f(V, Y)), f(f(U, f(W, Y)), V))))
= { by axiom 1 (hyp) R->L }
  f(X, Y)

Goal 1 (goal): x = y.
Proof:
  x
= { by lemma 2 R->L }
  f(f(X, f(f(Y, f(f(X, x), Y)), f(f(Z, f(W, Y)), f(X, x)))), f(f(x, f(f(f(Y, f(f(X, x), Y)), f(f(Z, f(W, Y)), f(X, x))), x)), Y))
