= { by lemma 10 R->L }
  f(f(V, f(f(Y, f(f(V, y), Y)), f(f(U, f(T, Y)), f(V, y)))), f(f(y, f(f(f(Y, f(f(V, y), Y)), f(f(U, f(T, Y)), f(V, y))), y)), Y))
= { by lemma 2 }
