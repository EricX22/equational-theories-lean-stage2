  f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(X, f(f(f(f(X, X), f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X))), X), f(f(f(X, X), f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X))), X))), X))
= { by lemma 19 }
  f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(X, f(f(f(f(X, X), f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X))), X), f(f(X, f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X))), X))), X))
= { by lemma 19 }
  f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(X, f(f(f(X, f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X))), X), f(f(X, f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X))), X))), X))
= { by lemma 25 }
  f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(X, f(X, f(f(f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X)), X), f(f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X)), X)))), X))
= { by lemma 22 }
  f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X)), X))
= { by lemma 24 }
