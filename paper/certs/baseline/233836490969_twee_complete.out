Lemma 28: f(f(X, f(f(Y, f(X, Y)), f(Y, f(X, Y)))), X) = f(X, f(f(Y, X), f(Y, X))).
Proof:
  f(f(X, f(f(Y, f(X, Y)), f(Y, f(X, Y)))), X)
= { by lemma 27 }
  f(f(Y, f(X, Y)), f(f(f(Y, f(X, Y)), f(Y, f(X, Y))), X))
= { by lemma 19 R->L }
  f(f(Y, f(X, Y)), f(f(f(Y, f(f(X, X), Y)), f(Y, f(X, Y))), X))
= { by lemma 19 R->L }
  f(f(Y, f(X, Y)), f(f(f(Y, f(f(X, X), Y)), f(Y, f(f(X, X), Y))), X))
= { by lemma 19 R->L }
  f(f(Y, f(X, Y)), f(f(f(Y, f(f(X, X), Y)), f(Y, f(f(X, X), Y))), f(X, X)))
= { by lemma 19 R->L }
  f(f(Y, f(f(X, X), Y)), f(f(f(Y, f(f(X, X), Y)), f(Y, f(f(X, X), Y))), f(X, X)))
= { by lemma 5 }
  f(f(X, X), f(f(Y, X), f(Y, X)))
= { by lemma 19 }
  f(X, f(f(Y, X), f(Y, X)))

Lemma 29: f(X, f(f(X, f(f(Y, X), f(Y, X))), f(X, f(f(Y, X), f(Y, X))))) = f(f(Y, f(X, Y)), f(Y, f(X, Y))).
Proof:
  f(X, f(f(X, f(f(Y, X), f(Y, X))), f(X, f(f(Y, X), f(Y, X)))))
= { by lemma 28 R->L }
  f(X, f(f(X, f(f(Y, X), f(Y, X))), f(f(X, f(f(Y, f(X, Y)), f(Y, f(X, Y)))), X)))
= { by lemma 19 R->L }
  f(f(X, X), f(f(X, f(f(Y, X), f(Y, X))), f(f(X, f(f(Y, f(X, Y)), f(Y, f(X, Y)))), X)))
= { by lemma 28 R->L }
  f(f(X, X), f(f(f(X, f(f(Y, f(X, Y)), f(Y, f(X, Y)))), X), f(f(X, f(f(Y, f(X, Y)), f(Y, f(X, Y)))), X)))
= { by lemma 7 }
  f(f(Y, f(X, Y)), f(Y, f(X, Y)))

Lemma 30: f(f(f(X, Y), f(X, f(X, Y))), f(f(X, Y), f(X, f(X, Y)))) = f(X, f(Y, Y)).
Proof:
  f(f(f(X, Y), f(X, f(X, Y))), f(f(X, Y), f(X, f(X, Y))))
= { by lemma 29 R->L }
  f(X, f(f(X, f(f(f(X, Y), X), f(f(X, Y), X))), f(X, f(f(f(X, Y), X), f(f(X, Y), X)))))
= { by lemma 9 R->L }
  f(X, f(f(X, f(f(Z, f(X, X)), f(f(Y, Z), f(Y, f(X, X))))), f(X, f(f(f(X, Y), X), f(f(X, Y), X)))))
= { by lemma 19 }
  f(X, f(f(X, f(f(Z, X), f(f(Y, Z), f(Y, f(X, X))))), f(X, f(f(f(X, Y), X), f(f(X, Y), X)))))
= { by lemma 19 }
  f(X, f(f(X, f(f(Z, X), f(f(Y, Z), f(Y, X)))), f(X, f(f(f(X, Y), X), f(f(X, Y), X)))))
= { by axiom 1 (hyp) R->L }
  f(X, f(Y, f(X, f(f(f(X, Y), X), f(f(X, Y), X)))))
= { by lemma 25 }
  f(X, f(Y, f(X, f(X, f(f(Y, X), f(Y, X))))))
= { by lemma 22 }
  f(X, f(Y, Y))

Lemma 31: f(f(X, f(f(Y, f(f(Z, Y), W)), Z)), f(f(W, X), f(W, f(f(Y, f(f(Z, Y), W)), Z)))) = f(f(Y, f(f(Z, Y), W)), Y).
Proof:
