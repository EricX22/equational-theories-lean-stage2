  f(X, f(f(f(f(f(Y, Y), Y), f(f(Y, Y), Y)), X), f(Y, f(f(Y, Y), X))))
= { by lemma 11 R->L }
  f(X, f(f(f(f(f(Y, Y), Y), f(f(Y, Y), Y)), f(f(f(Y, f(f(Y, Y), X)), Y), f(f(Y, f(f(Y, Y), X)), Y))), f(Y, f(f(Y, Y), X))))
= { by lemma 11 R->L }
  f(f(f(f(Y, f(f(Y, Y), X)), Y), f(f(Y, f(f(Y, Y), X)), Y)), f(f(f(f(f(Y, Y), Y), f(f(Y, Y), Y)), f(f(f(Y, f(f(Y, Y), X)), Y), f(f(Y, f(f(Y, Y), X)), Y))), f(Y, f(f(Y, Y), X))))
= { by lemma 12 }
  f(Y, Y)

Lemma 14: f(f(X, f(f(f(X, X), f(X, X)), X)), f(f(X, X), f(X, f(f(f(X, X), f(X, X)), X)))) = f(f(f(X, X), X), f(f(X, X), X)).
Proof:
  f(f(X, f(f(f(X, X), f(X, X)), X)), f(f(X, X), f(X, f(f(f(X, X), f(X, X)), X))))
= { by lemma 10 R->L }
  f(f(X, f(f(f(X, X), f(X, X)), X)), f(f(X, X), f(f(Y, f(f(f(X, X), X), f(f(X, X), X))), f(f(f(X, X), Y), X))))
= { by lemma 10 R->L }
  f(f(f(Z, f(f(f(X, X), X), f(f(X, X), X))), f(f(f(X, X), Z), X)), f(f(X, X), f(f(Y, f(f(f(X, X), X), f(f(X, X), X))), f(f(f(X, X), Y), X))))
= { by lemma 7 R->L }
  f(f(f(Z, f(f(f(X, X), X), f(f(X, X), X))), f(f(f(X, X), Z), f(f(X, X), f(f(f(X, X), X), f(f(X, X), X))))), f(f(X, X), f(f(Y, f(f(f(X, X), X), f(f(X, X), X))), f(f(f(X, X), Y), X))))
= { by lemma 7 R->L }
  f(f(f(Z, f(f(f(X, X), X), f(f(X, X), X))), f(f(f(X, X), Z), f(f(X, X), f(f(f(X, X), X), f(f(X, X), X))))), f(f(X, X), f(f(Y, f(f(f(X, X), X), f(f(X, X), X))), f(f(f(X, X), Y), f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))))))
= { by axiom 1 (hyp) }
  f(f(f(Z, f(f(f(X, X), X), f(f(X, X), X))), f(f(f(X, f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))), Z), f(f(X, X), f(f(f(X, X), X), f(f(X, X), X))))), f(f(X, X), f(f(Y, f(f(f(X, X), X), f(f(X, X), X))), f(f(f(X, X), Y), f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))))))
= { by axiom 1 (hyp) }
  f(f(f(Z, f(f(f(X, X), X), f(f(X, X), X))), f(f(f(X, f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))), Z), f(f(X, f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))), f(f(f(X, X), X), f(f(X, X), X))))), f(f(X, X), f(f(Y, f(f(f(X, X), X), f(f(X, X), X))), f(f(f(X, X), Y), f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))))))
= { by axiom 1 (hyp) }
  f(f(f(Z, f(f(f(X, X), X), f(f(X, X), X))), f(f(f(X, f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))), Z), f(f(X, f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))), f(f(f(X, X), X), f(f(X, X), X))))), f(f(X, f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))), f(f(Y, f(f(f(X, X), X), f(f(X, X), X))), f(f(f(X, X), Y), f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))))))
= { by lemma 13 R->L }
  f(f(f(Z, f(f(f(X, X), X), f(f(X, X), X))), f(f(f(X, f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))), Z), f(f(X, f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))), f(f(f(X, X), X), f(f(X, X), X))))), f(f(X, f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))), f(f(Y, f(f(f(X, X), X), f(f(X, X), X))), f(f(f(X, X), Y), f(f(f(f(f(X, X), X), f(f(X, X), X)), f(f(f(f(f(X, X), X), f(f(X, X), X)), f(f(f(X, X), X), f(f(X, X), X))), f(X, f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))))), f(f(f(X, X), X), f(f(X, X), X)))))))
= { by lemma 13 R->L }
  f(f(f(Z, f(f(f(X, X), X), f(f(X, X), X))), f(f(f(X, f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))), Z), f(f(X, f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))), f(f(f(X, X), X), f(f(X, X), X))))), f(f(X, f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))), f(f(Y, f(f(f(X, X), X), f(f(X, X), X))), f(f(f(f(f(f(X, X), X), f(f(X, X), X)), f(f(f(f(f(X, X), X), f(f(X, X), X)), f(f(f(X, X), X), f(f(X, X), X))), f(X, f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))))), Y), f(f(f(f(f(X, X), X), f(f(X, X), X)), f(f(f(f(f(X, X), X), f(f(X, X), X)), f(f(f(X, X), X), f(f(X, X), X))), f(X, f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))))), f(f(f(X, X), X), f(f(X, X), X)))))))
= { by lemma 7 }
  f(f(f(Z, f(f(f(X, X), X), f(f(X, X), X))), f(f(f(X, f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))), Z), f(f(X, f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))), f(f(f(X, X), X), f(f(X, X), X))))), f(f(X, f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))), f(f(f(f(f(X, X), X), f(f(X, X), X)), f(f(f(X, X), X), f(f(X, X), X))), f(X, f(f(X, X), f(f(f(X, X), X), f(f(X, X), X)))))))
= { by lemma 3 }
  f(f(f(X, X), X), f(f(X, X), X))

Lemma 15: f(f(f(X, X), f(X, X)), X) = f(X, X).
Proof:
  f(f(f(X, X), f(X, X)), X)
= { by lemma 7 R->L }
  f(f(Y, X), f(f(f(X, f(f(f(X, X), f(X, X)), X)), Y), f(f(X, f(f(f(X, X), f(X, X)), X)), X)))
= { by lemma 5 R->L }
  f(f(f(X, f(f(f(X, X), f(X, X)), X)), f(f(X, X), f(X, f(f(f(X, X), f(X, X)), X)))), f(f(f(f(X, f(f(f(X, X), f(X, X)), X)), f(f(X, X), f(X, f(f(f(X, X), f(X, X)), X)))), f(f(X, f(f(f(X, X), f(X, X)), X)), f(f(X, X), f(X, f(f(f(X, X), f(X, X)), X))))), f(X, X)))
= { by lemma 14 }
  f(f(f(f(X, X), X), f(f(X, X), X)), f(f(f(f(X, f(f(f(X, X), f(X, X)), X)), f(f(X, X), f(X, f(f(f(X, X), f(X, X)), X)))), f(f(X, f(f(f(X, X), f(X, X)), X)), f(f(X, X), f(X, f(f(f(X, X), f(X, X)), X))))), f(X, X)))
= { by lemma 14 }
  f(f(f(f(X, X), X), f(f(X, X), X)), f(f(f(f(f(X, X), X), f(f(X, X), X)), f(f(X, f(f(f(X, X), f(X, X)), X)), f(f(X, X), f(X, f(f(f(X, X), f(X, X)), X))))), f(X, X)))
= { by lemma 14 }
  f(f(f(f(X, X), X), f(f(X, X), X)), f(f(f(f(f(X, X), X), f(f(X, X), X)), f(f(f(X, X), X), f(f(X, X), X))), f(X, X)))
= { by lemma 12 }
  f(X, X)

Lemma 16: f(f(X, X), f(X, X)) = X.
Proof:
  f(f(X, X), f(X, X))
= { by lemma 2 R->L }
  f(f(f(X, X), f(f(X, X), f(X, X))), f(X, f(f(f(f(X, X), f(X, X)), X), f(f(f(X, X), f(X, X)), f(f(X, X), f(f(X, X), f(X, X)))))))
= { by lemma 8 R->L }
  f(f(f(X, X), f(f(X, X), f(X, X))), f(X, f(f(f(f(X, X), f(X, X)), X), f(f(X, f(f(X, X), f(f(f(f(X, X), f(X, X)), X), f(f(f(X, X), f(X, X)), X)))), f(f(X, X), f(f(X, X), f(X, X)))))))
= { by lemma 15 }
  f(f(f(X, X), f(f(X, X), f(X, X))), f(X, f(f(f(f(X, X), f(X, X)), X), f(f(X, f(f(X, X), f(f(f(f(X, X), f(X, X)), X), f(X, X)))), f(f(X, X), f(f(X, X), f(X, X)))))))
= { by lemma 15 }
  f(f(f(X, X), f(f(X, X), f(X, X))), f(X, f(f(f(f(X, X), f(X, X)), X), f(f(X, f(f(X, X), f(f(X, X), f(X, X)))), f(f(X, X), f(f(X, X), f(X, X)))))))
= { by axiom 1 (hyp) R->L }
  f(f(f(X, X), f(f(X, X), f(X, X))), f(X, f(f(f(f(X, X), f(X, X)), X), f(X, f(f(X, X), f(f(X, X), f(X, X)))))))
= { by axiom 1 (hyp) R->L }
  f(f(f(X, X), f(f(X, X), f(X, X))), f(X, f(f(f(f(X, X), f(X, X)), X), X)))
= { by lemma 15 }
  f(f(f(X, X), f(f(X, X), f(X, X))), f(X, f(f(X, X), X)))
= { by lemma 3 }
  X

Lemma 17: f(X, f(f(X, X), X)) = X.
Proof:
  f(X, f(f(X, X), X))
= { by lemma 16 R->L }
  f(X, f(f(X, X), f(f(X, X), f(X, X))))
= { by axiom 1 (hyp) R->L }
  X

Lemma 18: f(f(X, X), X) = f(X, X).
Proof:
  f(f(X, X), X)
= { by lemma 16 R->L }
  f(f(X, X), f(f(X, X), f(X, X)))
= { by lemma 5 R->L }
  f(f(X, f(f(X, X), X)), f(f(f(X, f(f(X, X), X)), f(X, f(f(X, X), X))), f(X, X)))
= { by lemma 17 }
  f(X, f(f(f(X, f(f(X, X), X)), f(X, f(f(X, X), X))), f(X, X)))
= { by lemma 17 }
  f(X, f(f(X, f(X, f(f(X, X), X))), f(X, X)))
= { by lemma 17 }
  f(X, f(f(X, X), f(X, X)))
= { by lemma 16 }
  f(X, X)

Lemma 19: f(X, X) = X.
Proof:
  f(X, X)
= { by axiom 1 (hyp) }
  f(f(f(X, X), f(X, X)), f(f(f(f(f(X, X), X), f(f(X, X), X)), f(f(X, X), f(X, X))), f(f(f(X, X), f(f(f(X, X), X), f(f(X, X), X))), f(f(X, X), f(f(X, X), f(X, X))))))
= { by lemma 3 }
  f(f(f(X, X), f(X, X)), f(f(f(f(f(X, X), X), f(f(X, X), X)), f(f(X, X), f(X, X))), X))
= { by lemma 18 }
  f(f(f(X, X), f(X, X)), f(f(f(f(X, X), f(f(X, X), X)), f(f(X, X), f(X, X))), X))
= { by lemma 16 }
  f(X, f(f(f(f(X, X), f(f(X, X), X)), f(f(X, X), f(X, X))), X))
= { by lemma 16 }
  f(X, f(f(f(f(X, X), f(f(X, X), X)), X), X))
= { by lemma 18 }
  f(X, f(f(f(f(X, X), f(X, X)), X), X))
= { by lemma 15 }
  f(X, f(f(X, X), X))
= { by lemma 17 }
  X

Lemma 20: f(f(W, Y), f(f(Z, W), f(Z, Y))) = f(f(X, Y), f(f(Z, X), f(Z, Y))).
Proof:
  f(f(W, Y), f(f(Z, W), f(Z, Y)))
= { by lemma 4 R->L }
  f(f(Z, f(f(Y, Y), Z)), f(f(f(Z, f(f(Y, Y), Z)), f(Z, f(f(Y, Y), Z))), f(Y, f(f(f(W, Y), f(f(Z, W), f(Z, Y))), f(Z, f(f(Y, Y), Z))))))
= { by lemma 3 }
  f(f(Z, f(f(Y, Y), Z)), f(f(f(Z, f(f(Y, Y), Z)), f(Z, f(f(Y, Y), Z))), f(Y, Y)))
= { by lemma 3 R->L }
  f(f(Z, f(f(Y, Y), Z)), f(f(f(Z, f(f(Y, Y), Z)), f(Z, f(f(Y, Y), Z))), f(Y, f(f(f(X, Y), f(f(Z, X), f(Z, Y))), f(Z, f(f(Y, Y), Z))))))
= { by lemma 4 }
  f(f(X, Y), f(f(Z, X), f(Z, Y)))

Lemma 21: f(f(X, Y), f(f(Y, X), Y)) = Y.
Proof:
  f(f(X, Y), f(f(Y, X), Y))
= { by lemma 19 R->L }
  f(f(X, Y), f(f(Y, X), f(Y, Y)))
= { by lemma 20 R->L }
  f(f(Y, Y), f(f(Y, Y), f(Y, Y)))
= { by lemma 19 }
  f(Y, f(f(Y, Y), f(Y, Y)))
= { by lemma 19 }
  f(Y, f(Y, f(Y, Y)))
= { by lemma 19 }
  f(Y, f(Y, Y))
= { by lemma 19 }
  f(Y, Y)
= { by lemma 19 }
  Y

Lemma 22: f(X, f(X, f(f(Y, X), f(Y, X)))) = Y.
Proof:
  f(X, f(X, f(f(Y, X), f(Y, X))))
= { by lemma 19 R->L }
  f(X, f(f(X, X), f(f(Y, X), f(Y, X))))
= { by axiom 1 (hyp) R->L }
  Y

Lemma 23: f(f(f(f(f(X, Y), Z), f(f(X, Y), X)), W), f(Y, f(f(Z, X), W))) = f(f(V, W), f(f(f(Z, X), V), f(f(Z, X), W))).
Proof:
  f(f(f(f(f(X, Y), Z), f(f(X, Y), X)), W), f(Y, f(f(Z, X), W)))
= { by lemma 7 R->L }
  f(f(f(f(f(X, Y), Z), f(f(X, Y), X)), W), f(f(f(Z, X), f(f(f(X, Y), Z), f(f(X, Y), X))), f(f(Z, X), W)))
= { by lemma 20 R->L }
  f(f(V, W), f(f(f(Z, X), V), f(f(Z, X), W)))

Lemma 24: f(f(f(f(f(X, f(X, Y)), Y), f(f(X, f(X, Y)), X)), Y), Y) = X.
Proof:
  f(f(f(f(f(X, f(X, Y)), Y), f(f(X, f(X, Y)), X)), Y), Y)
= { by lemma 21 R->L }
  f(f(f(f(f(X, f(X, Y)), Y), f(f(X, f(X, Y)), X)), Y), f(f(X, Y), f(f(Y, X), Y)))
= { by lemma 23 }
  f(f(Z, Y), f(f(f(Y, X), Z), f(f(Y, X), Y)))
= { by lemma 7 }
  X

Lemma 25: f(f(f(X, Y), X), f(f(X, Y), X)) = f(X, f(f(Y, X), f(Y, X))).
Proof:
  f(f(f(X, Y), X), f(f(X, Y), X))
= { by lemma 9 R->L }
  f(f(X, f(X, X)), f(f(Y, X), f(Y, f(X, X))))
= { by lemma 19 }
  f(f(X, X), f(f(Y, X), f(Y, f(X, X))))
= { by lemma 19 }
  f(X, f(f(Y, X), f(Y, f(X, X))))
= { by lemma 19 }
  f(X, f(f(Y, X), f(Y, X)))

Lemma 26: f(f(X, f(f(Y, Y), X)), f(Y, f(X, f(Y, f(X, f(f(Y, Y), X)))))) = Y.
Proof:
  f(f(X, f(f(Y, Y), X)), f(Y, f(X, f(Y, f(X, f(f(Y, Y), X))))))
= { by lemma 3 R->L }
  f(f(X, f(f(Y, Y), X)), f(f(f(f(Z, Y), f(f(X, Z), f(X, Y))), f(X, f(f(Y, Y), X))), f(X, f(Y, f(X, f(f(Y, Y), X))))))
= { by lemma 6 }
  Y

Lemma 27: f(f(X, f(Y, Y)), X) = f(Y, f(f(Y, Y), X)).
Proof:
  f(f(X, f(Y, Y)), X)
= { by lemma 24 R->L }
  f(f(X, f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), Y)), X)
= { by lemma 24 R->L }
  f(f(X, f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X))), X)
= { by lemma 19 R->L }
  f(f(f(X, X), f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X))), X)
= { by axiom 1 (hyp) }
  f(f(X, f(f(X, X), f(f(f(f(X, X), f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X))), X), f(f(f(X, X), f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X))), X)))), X)
= { by lemma 19 R->L }
  f(f(X, f(f(X, X), f(f(f(f(X, X), f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X))), X), f(f(f(X, X), f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X))), X)))), f(X, X))
= { by lemma 19 R->L }
  f(f(X, f(f(X, X), f(f(f(f(X, X), f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X))), X), f(f(f(X, X), f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X))), X)))), f(X, f(X, X)))
= { by lemma 19 R->L }
  f(f(X, f(f(X, X), f(f(f(f(X, X), f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X))), X), f(f(f(X, X), f(f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X), f(f(f(f(f(Y, f(Y, X)), X), f(f(Y, f(Y, X)), Y)), X), X))), X)))), f(X, f(X, f(X, X))))
= { by lemma 19 R->L }
