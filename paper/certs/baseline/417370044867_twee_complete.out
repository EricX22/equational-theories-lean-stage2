Lemma 14: f(X, Z) = f(X, Y).
Proof:
  f(X, Z)
= { by lemma 9 R->L }
  f(f(f(f(f(f(X, Z), X), W), f(f(X, Z), X)), f(f(f(X, Z), X), f(f(X, Z), X))), f(f(X, Z), X))
= { by lemma 13 }
  f(f(f(f(f(f(X, Z), X), W), f(f(X, Z), X)), f(f(f(X, Z), X), f(f(X, Z), X))), f(f(X, Y), X))
= { by lemma 13 }
  f(f(f(f(f(f(X, Z), X), W), f(f(X, Z), X)), f(f(f(X, Z), X), f(f(X, Y), X))), f(f(X, Y), X))
= { by lemma 13 }
  f(f(f(f(f(f(X, Z), X), W), f(f(X, Z), X)), f(f(f(X, Y), X), f(f(X, Y), X))), f(f(X, Y), X))
= { by lemma 13 }
  f(f(f(f(f(f(X, Z), X), W), f(f(X, Y), X)), f(f(f(X, Y), X), f(f(X, Y), X))), f(f(X, Y), X))
= { by lemma 13 }
  f(f(f(f(f(f(X, Y), X), W), f(f(X, Y), X)), f(f(f(X, Y), X), f(f(X, Y), X))), f(f(X, Y), X))
= { by lemma 9 }
  f(X, Y)

Lemma 15: f(f(X, Y), X) = f(X, Y).
Proof:
  f(f(X, Y), X)
= { by lemma 11 R->L }
  f(f(f(X, Y), X), X)
= { by lemma 14 }
  f(f(f(X, Y), X), f(f(X, Y), X))
= { by lemma 11 R->L }
  f(f(f(f(X, Y), X), X), f(f(X, Y), X))
= { by lemma 11 R->L }
  f(f(f(f(f(X, Y), X), X), X), f(f(X, Y), X))
= { by lemma 14 }
  f(f(f(f(f(X, Y), X), f(f(X, Y), X)), X), f(f(X, Y), X))
= { by lemma 14 }
  f(f(f(f(f(X, Y), X), f(f(X, Y), X)), f(f(f(X, Y), X), f(f(X, Y), X))), f(f(X, Y), X))
= { by lemma 11 R->L }
  f(f(f(f(f(f(X, Y), X), X), f(f(X, Y), X)), f(f(f(X, Y), X), f(f(X, Y), X))), f(f(X, Y), X))
= { by lemma 9 }
  f(X, Y)

Lemma 16: f(X, Y) = X.
Proof:
  f(X, Y)
= { by lemma 15 R->L }
  f(f(X, Y), X)
= { by lemma 14 }
  f(f(X, Y), f(X, Y))
= { by lemma 15 R->L }
  f(f(f(X, Y), X), f(X, Y))
= { by lemma 13 }
  f(f(f(X, Y), f(X, Y)), f(X, Y))
= { by lemma 15 R->L }
  f(f(f(X, Y), f(f(X, Y), X)), f(X, Y))
= { by lemma 14 }
  f(f(f(X, Y), f(f(X, Y), f(X, Y))), f(X, Y))
= { by lemma 15 R->L }
  f(f(f(X, Y), f(f(f(X, Y), X), f(X, Y))), f(X, Y))
= { by lemma 13 }
  f(f(f(X, Y), f(f(f(X, Y), f(X, Y)), f(X, Y))), f(X, Y))
= { by lemma 15 R->L }
  f(f(f(f(X, Y), X), f(f(f(X, Y), f(X, Y)), f(X, Y))), f(X, Y))
= { by lemma 15 R->L }
  f(f(f(f(X, Y), X), f(f(f(X, Y), f(X, Y)), f(X, Y))), f(f(X, Y), X))
= { by lemma 8 R->L }
  f(f(f(f(f(f(X, Y), X), Z), f(X, Y)), f(f(X, Y), f(f(X, Y), X))), f(f(X, Y), X))
= { by lemma 15 }
  f(f(f(f(f(X, Y), Z), f(X, Y)), f(f(X, Y), f(f(X, Y), X))), f(f(X, Y), X))
= { by lemma 15 }
  f(f(f(f(f(X, Y), Z), f(X, Y)), f(f(X, Y), f(X, Y))), f(f(X, Y), X))
= { by lemma 15 }
  f(f(f(f(f(X, Y), Z), f(X, Y)), f(f(X, Y), f(X, Y))), f(X, Y))
= { by lemma 9 }
  X

Lemma 17: f(f(f(f(f(f(f(X, Y), X), f(X, Z)), W), f(f(f(X, V), X), f(X, U))), f(f(f(f(X, V), X), f(X, T)), S)), f(f(f(X, V), X), f(X, X2))) = f(f(X, V), X).
Proof:
  f(f(f(f(f(f(f(X, Y), X), f(X, Z)), W), f(f(f(X, V), X), f(X, U))), f(f(f(f(X, V), X), f(X, T)), S)), f(f(f(X, V), X), f(X, X2)))
= { by lemma 14 }
  f(f(f(f(f(f(f(X, Y), X), f(X, Z)), W), f(f(f(X, V), X), f(X, U))), f(f(f(f(X, V), X), f(X, T)), f(f(f(X, V), X), f(X, X)))), f(f(f(X, V), X), f(X, X2)))
= { by lemma 14 }
  f(f(f(f(f(f(f(X, Y), X), f(X, X)), W), f(f(f(X, V), X), f(X, U))), f(f(f(f(X, V), X), f(X, T)), f(f(f(X, V), X), f(X, X)))), f(f(f(X, V), X), f(X, X2)))
= { by lemma 14 }
  f(f(f(f(f(f(f(X, Y), X), f(X, X)), W), f(f(f(X, V), X), f(X, X))), f(f(f(f(X, V), X), f(X, T)), f(f(f(X, V), X), f(X, X)))), f(f(f(X, V), X), f(X, X2)))
= { by lemma 14 }
  f(f(f(f(f(f(f(X, Y), X), f(X, X)), W), f(f(f(X, V), X), f(X, X))), f(f(f(f(X, V), X), f(X, X)), f(f(f(X, V), X), f(X, X)))), f(f(f(X, V), X), f(X, X2)))
= { by lemma 14 }
  f(f(f(f(f(f(f(X, Y), X), f(X, X)), W), f(f(f(X, V), X), f(X, X))), f(f(f(f(X, V), X), f(X, X)), f(f(f(X, V), X), f(X, X)))), f(f(f(X, V), X), f(X, X)))
= { by lemma 12 }
  f(f(f(f(f(f(f(X, V), X), f(X, X)), W), f(f(f(X, V), X), f(X, X))), f(f(f(f(X, V), X), f(X, X)), f(f(f(X, V), X), f(X, X)))), f(f(f(X, V), X), f(X, X)))
= { by lemma 9 }
  f(f(X, V), X)

Goal 1 (goal): x = y.
Proof:
  x
= { by axiom 1 (hyp) }
  f(f(f(f(X, Y), f(f(x, X), x)), f(f(x, Z), X)), X)
= { by lemma 16 }
  f(f(f(X, f(f(x, X), x)), f(f(x, Z), X)), X)
= { by lemma 16 }
  f(f(X, f(f(x, Z), X)), X)
= { by lemma 17 R->L }
  f(f(f(f(f(f(f(X, W), X), f(X, V)), U), f(f(f(X, f(f(x, Z), X)), X), f(X, X))), f(f(f(f(X, f(f(x, Z), X)), X), f(X, X)), T)), f(f(f(X, f(f(x, Z), X)), X), f(X, X)))
= { by lemma 12 R->L }
  f(f(f(f(f(f(f(X, W), X), f(X, V)), U), f(f(f(X, f(f(y, S), X)), X), f(X, X))), f(f(f(f(X, f(f(x, Z), X)), X), f(X, X)), T)), f(f(f(X, f(f(x, Z), X)), X), f(X, X)))
= { by lemma 12 R->L }
  f(f(f(f(f(f(f(X, W), X), f(X, V)), U), f(f(f(X, f(f(y, S), X)), X), f(X, X))), f(f(f(f(X, f(f(y, S), X)), X), f(X, X)), T)), f(f(f(X, f(f(x, Z), X)), X), f(X, X)))
= { by lemma 12 R->L }
  f(f(f(f(f(f(f(X, W), X), f(X, V)), U), f(f(f(X, f(f(y, S), X)), X), f(X, X))), f(f(f(f(X, f(f(y, S), X)), X), f(X, X)), T)), f(f(f(X, f(f(y, S), X)), X), f(X, X)))
= { by lemma 17 }
  f(f(X, f(f(y, S), X)), X)
= { by lemma 16 R->L }
  f(f(f(X, f(f(y, X), y)), f(f(y, S), X)), X)
= { by lemma 16 R->L }
  f(f(f(f(X, X2), f(f(y, X), y)), f(f(y, S), X)), X)
= { by axiom 1 (hyp) R->L }
  y
% SZS output end Proof

