  f(f(f(f(f(f(X, f(f(f(f(X, V), X), f(X, X)), X)), f(f(f(X, X), X), f(X, X))), f(f(f(f(f(X, X), X), f(X, X)), W), f(f(f(X, X), X), f(X, X)))), f(X, f(X, X))), X), f(f(X, Z), X))
