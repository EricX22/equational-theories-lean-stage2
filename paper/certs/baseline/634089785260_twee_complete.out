  f(f(f(X, X), f(Y, f(Y, f(f(X, X), f(X, X))))), f(f(f(X, V), f(f(X, X), f(f(X, X), f(V, V)))), f(f(X, V), f(f(X, X), f(f(X, X), f(V, V))))))
