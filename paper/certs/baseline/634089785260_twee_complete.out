  f(f(f(f(f(f(X, f(X, f(Y, Y))), Y), Y), f(X, f(X, f(Y, Y)))), f(f(f(X, f(X, f(Y, Y))), Y), f(f(X, f(X, f(Y, Y))), Y))), f(f(f(f(f(f(X, f(X, f(Y, Y))), Y), Y), f(X, f(X, f(Y, Y)))), f(f(f(f(X, f(X, f(Y, Y))), Y), Y), f(X, f(X, f(Y, Y))))), f(f(f(f(f(f(X, f(X, f(Y, Y))), Y), Y), f(X, f(X, f(Y, Y)))), f(f(f(f(X, f(X, f(Y, Y))), Y), Y), f(X, f(X, f(Y, Y))))), f(f(f(f(X, f(X, f(Y, Y))), Y), f(f(X, f(X, f(Y, Y))), Y)), f(f(f(X, f(X, f(Y, Y))), Y), f(f(X, f(X, f(Y, Y))), Y))))))
= { by lemma 3 }
  f(f(f(Z, f(f(f(f(X, f(X, f(Y, Y))), Y), Y), f(X, f(X, f(Y, Y))))), f(f(f(f(f(X, f(X, f(Y, Y))), Y), Y), f(X, f(X, f(Y, Y)))), f(f(f(f(X, f(X, f(Y, Y))), Y), Y), f(X, f(X, f(Y, Y)))))), f(Z, Z))
= { by lemma 25 }
  f(f(f(Z, Y), f(f(f(f(f(X, f(X, f(Y, Y))), Y), Y), f(X, f(X, f(Y, Y)))), f(f(f(f(X, f(X, f(Y, Y))), Y), Y), f(X, f(X, f(Y, Y)))))), f(Z, Z))
