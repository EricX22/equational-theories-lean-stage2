Lemma 27: f(f(f(X, X), f(Y, f(Y, f(f(X, X), f(X, X))))), f(f(f(f(Z, X), f(X, X)), f(Z, Z)), f(f(f(W, X), f(X, X)), f(W, W)))) = Y.
Proof:
  f(f(f(X, X), f(Y, f(Y, f(f(X, X), f(X, X))))), f(f(f(f(Z, X), f(X, X)), f(Z, Z)), f(f(f(W, X), f(X, X)), f(W, W))))
