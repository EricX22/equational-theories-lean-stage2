  f(f(f(Z, f(X, f(f(Y, Y), f(f(Y, Y), f(Y, Y))))), f(X, f(f(Y, Y), f(f(Y, Y), f(Y, Y))))), Z)
= { by lemma 24 R->L }
  f(f(f(Z, f(X, f(f(Y, Y), f(f(Y, Y), f(Y, Y))))), f(X, f(f(Y, Y), f(f(Y, Y), f(Y, Y))))), f(Z, Z))
