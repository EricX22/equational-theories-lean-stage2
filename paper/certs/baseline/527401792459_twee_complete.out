= { by lemma 15 R->L }
  f(X, f(f(X, f(X, Y)), f(f(X, Y), X)))
= { by lemma 10 R->L }
  f(X, f(f(f(f(X, Y), X), f(X, f(X, Y))), f(f(X, Y), X)))
= { by lemma 17 R->L }
  f(X, f(f(f(f(X, Y), X), f(f(f(X, Y), X), f(X, Y))), f(f(X, Y), X)))
= { by lemma 16 }
  f(X, f(f(f(f(X, Y), X), f(X, Y)), f(f(X, Y), X)))
= { by lemma 17 }
  f(X, f(f(X, Y), f(f(X, Y), X)))
= { by lemma 17 }
  f(X, f(f(X, Y), f(Y, X)))
= { by lemma 15 }
  Y

Goal 1 (goal): x = y.
Proof:
  x
= { by lemma 18 R->L }
  f(y, x)
= { by lemma 18 R->L }
  f(X, f(y, x))
= { by lemma 18 R->L }
  f(f(f(y, x), f(x, y)), f(X, f(y, x)))
= { by lemma 18 R->L }
  f(x, f(f(f(y, x), f(x, y)), f(X, f(y, x))))
= { by axiom 1 (hyp) R->L }
  y
% SZS output end Proof

RESULT: Theorem (the conjecture is true).
