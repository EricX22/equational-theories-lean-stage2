  f(X, f(f(X, Y), X))

Lemma 12: f(f(X, f(f(X, Y), X)), f(f(f(X, f(f(X, Y), X)), f(f(X, Y), X)), f(X, f(f(X, Y), X)))) = f(X, f(Y, X)).
Proof:
  f(f(X, f(f(X, Y), X)), f(f(f(X, f(f(X, Y), X)), f(f(X, Y), X)), f(X, f(f(X, Y), X))))
= { by lemma 11 R->L }
  f(f(f(f(f(X, Y), X), f(X, f(f(X, Y), X))), f(X, f(Y, X))), f(f(f(X, f(f(X, Y), X)), f(f(X, Y), X)), f(X, f(f(X, Y), X))))
= { by lemma 11 R->L }
  f(f(f(f(f(X, Y), X), f(f(f(f(X, Y), X), f(X, f(f(X, Y), X))), f(X, f(Y, X)))), f(X, f(Y, X))), f(f(f(X, f(f(X, Y), X)), f(f(X, Y), X)), f(X, f(f(X, Y), X))))
= { by axiom 1 (hyp) R->L }
  f(X, f(Y, X))

Lemma 13: f(f(f(f(X, Y), X), f(f(Y, f(f(Y, X), Z)), Z)), f(f(X, Y), X)) = f(W, f(f(W, f(f(f(Y, f(f(Y, X), Z)), Z), f(Z, W))), W)).
Proof:
  f(f(f(f(X, Y), X), f(f(Y, f(f(Y, X), Z)), Z)), f(f(X, Y), X))
= { by lemma 2 R->L }
  f(W, f(f(W, f(f(f(Y, f(f(Y, X), Z)), Z), f(f(f(f(Y, f(f(Y, X), Z)), Z), f(f(X, Y), X)), W))), W))
= { by axiom 1 (hyp) R->L }
  f(W, f(f(W, f(f(f(Y, f(f(Y, X), Z)), Z), f(Z, W))), W))

Lemma 14: f(f(f(X, Y), X), f(Z, f(f(Z, f(f(f(Y, f(f(Y, X), W)), W), f(W, Z))), Z))) = f(f(W, f(Y, f(f(Y, X), W))), W).
Proof:
  f(f(f(X, Y), X), f(Z, f(f(Z, f(f(f(Y, f(f(Y, X), W)), W), f(W, Z))), Z)))
= { by lemma 13 R->L }
  f(f(f(X, Y), X), f(f(f(f(X, Y), X), f(f(Y, f(f(Y, X), W)), W)), f(f(X, Y), X)))
= { by axiom 1 (hyp) }
  f(f(f(X, Y), X), f(f(f(f(X, Y), X), f(f(Y, f(f(Y, X), W)), f(f(f(Y, f(f(Y, X), W)), W), f(f(X, Y), X)))), f(f(X, Y), X)))
= { by lemma 2 }
  f(f(W, f(Y, f(f(Y, X), W))), W)

Lemma 15: f(f(f(f(f(X, f(f(X, Y), Z)), Z), f(Z, W)), W), f(V, f(f(V, f(f(f(X, f(f(X, Y), Z)), Z), f(Z, V))), V))) = W.
Proof:
  f(f(f(f(f(X, f(f(X, Y), Z)), Z), f(Z, W)), W), f(V, f(f(V, f(f(f(X, f(f(X, Y), Z)), Z), f(Z, V))), V)))
= { by lemma 13 R->L }
  f(f(f(f(f(X, f(f(X, Y), Z)), Z), f(Z, W)), W), f(f(f(f(Y, X), Y), f(f(X, f(f(X, Y), Z)), Z)), f(f(Y, X), Y)))
= { by axiom 1 (hyp) }
  f(f(f(f(f(X, f(f(X, Y), Z)), Z), f(f(f(f(X, f(f(X, Y), Z)), Z), f(f(Y, X), Y)), W)), W), f(f(f(f(Y, X), Y), f(f(X, f(f(X, Y), Z)), Z)), f(f(Y, X), Y)))
= { by axiom 1 (hyp) R->L }
  W

Lemma 16: f(f(f(X, Y), f(Y, f(f(Y, X), f(X, Y)))), f(X, Y)) = X.
Proof:
  f(f(f(X, Y), f(Y, f(f(Y, X), f(X, Y)))), f(X, Y))
= { by lemma 14 R->L }
  f(f(f(X, Y), X), f(Z, f(f(Z, f(f(f(Y, f(f(Y, X), f(X, Y))), f(X, Y)), f(f(X, Y), Z))), Z)))
= { by axiom 1 (hyp) }
  f(f(f(f(f(Y, f(f(Y, X), f(X, Y))), f(X, Y)), f(f(X, Y), X)), X), f(Z, f(f(Z, f(f(f(Y, f(f(Y, X), f(X, Y))), f(X, Y)), f(f(X, Y), Z))), Z)))
= { by lemma 15 }
  X

Lemma 17: f(f(f(f(X, f(f(X, Y), f(Y, X))), f(f(f(X, f(f(X, Y), f(Y, X))), f(Y, X)), Z)), Z), Y) = Z.
Proof:
  f(f(f(f(X, f(f(X, Y), f(Y, X))), f(f(f(X, f(f(X, Y), f(Y, X))), f(Y, X)), Z)), Z), Y)
= { by lemma 16 R->L }
  f(f(f(f(X, f(f(X, Y), f(Y, X))), f(f(f(X, f(f(X, Y), f(Y, X))), f(Y, X)), Z)), Z), f(f(f(Y, X), f(X, f(f(X, Y), f(Y, X)))), f(Y, X)))
= { by axiom 1 (hyp) R->L }
  Z

Lemma 18: f(V, f(f(V, f(Y, f(f(f(Z, W), Z), V))), V)) = f(X, f(f(X, f(Y, f(f(f(Z, W), Z), X))), X)).
Proof:
  f(V, f(f(V, f(Y, f(f(f(Z, W), Z), V))), V))
= { by axiom 1 (hyp) }
  f(V, f(f(V, f(f(f(f(W, f(f(W, Z), Y)), Y), f(f(Z, W), Z)), f(f(f(Z, W), Z), V))), V))
= { by axiom 1 (hyp) }
  f(V, f(f(V, f(f(f(f(W, f(f(W, Z), Y)), f(f(f(U, f(f(U, T), Y)), Y), f(f(T, U), T))), f(f(Z, W), Z)), f(f(f(Z, W), Z), V))), V))
= { by lemma 7 }
  f(X, f(f(X, f(f(f(f(W, f(f(W, Z), Y)), f(f(f(U, f(f(U, T), Y)), Y), f(f(T, U), T))), f(f(Z, W), Z)), f(f(f(Z, W), Z), X))), X))
= { by axiom 1 (hyp) R->L }
  f(X, f(f(X, f(f(f(f(W, f(f(W, Z), Y)), Y), f(f(Z, W), Z)), f(f(f(Z, W), Z), X))), X))
= { by axiom 1 (hyp) R->L }
  f(X, f(f(X, f(Y, f(f(f(Z, W), Z), X))), X))

Lemma 19: f(f(X, f(f(X, Y), X)), f(f(f(X, f(f(X, Y), X)), f(Z, X)), f(X, f(f(X, Y), X)))) = f(W, f(f(W, f(Z, f(f(Y, X), W))), W)).
Proof:
  f(f(X, f(f(X, Y), X)), f(f(f(X, f(f(X, Y), X)), f(Z, X)), f(X, f(f(X, Y), X))))
= { by lemma 6 R->L }
  f(f(X, f(f(X, Y), X)), f(f(f(X, f(f(X, Y), X)), f(Z, f(f(Y, X), f(X, f(f(X, Y), X))))), f(X, f(f(X, Y), X))))
= { by lemma 17 R->L }
  f(f(X, f(f(X, Y), X)), f(f(f(X, f(f(X, Y), X)), f(Z, f(f(Y, f(f(f(f(V, f(f(V, Y), f(Y, V))), f(f(f(V, f(f(V, Y), f(Y, V))), f(Y, V)), X)), X), Y)), f(X, f(f(X, Y), X))))), f(X, f(f(X, Y), X))))
= { by lemma 6 R->L }
  f(f(X, f(f(X, Y), X)), f(f(f(X, f(f(X, Y), X)), f(Z, f(f(f(f(f(f(f(V, f(f(V, Y), f(Y, V))), f(f(f(V, f(f(V, Y), f(Y, V))), f(Y, V)), X)), X), Y), f(Y, f(f(Y, f(f(f(V, f(f(V, Y), f(Y, V))), f(f(f(V, f(f(V, Y), f(Y, V))), f(Y, V)), X)), X)), Y))), f(f(f(f(V, f(f(V, Y), f(Y, V))), f(f(f(V, f(f(V, Y), f(Y, V))), f(Y, V)), X)), X), Y)), f(X, f(f(X, Y), X))))), f(X, f(f(X, Y), X))))
= { by lemma 18 R->L }
  f(W, f(f(W, f(Z, f(f(f(f(f(f(f(V, f(f(V, Y), f(Y, V))), f(f(f(V, f(f(V, Y), f(Y, V))), f(Y, V)), X)), X), Y), f(Y, f(f(Y, f(f(f(V, f(f(V, Y), f(Y, V))), f(f(f(V, f(f(V, Y), f(Y, V))), f(Y, V)), X)), X)), Y))), f(f(f(f(V, f(f(V, Y), f(Y, V))), f(f(f(V, f(f(V, Y), f(Y, V))), f(Y, V)), X)), X), Y)), W))), W))
= { by lemma 6 }
  f(W, f(f(W, f(Z, f(f(Y, f(f(f(f(V, f(f(V, Y), f(Y, V))), f(f(f(V, f(f(V, Y), f(Y, V))), f(Y, V)), X)), X), Y)), W))), W))
= { by lemma 17 }
  f(W, f(f(W, f(Z, f(f(Y, X), W))), W))

Lemma 20: f(X, f(f(X, f(f(Y, Z), f(f(Z, Y), X))), X)) = f(Y, f(Z, Y)).
Proof:
  f(X, f(f(X, f(f(Y, Z), f(f(Z, Y), X))), X))
= { by lemma 19 R->L }
  f(f(Y, f(f(Y, Z), Y)), f(f(f(Y, f(f(Y, Z), Y)), f(f(Y, Z), Y)), f(Y, f(f(Y, Z), Y))))
= { by lemma 12 }
  f(Y, f(Z, Y))

Lemma 21: f(X, f(f(f(X, f(f(X, Y), f(f(Y, X), X))), X), X)) = f(X, f(f(Y, X), X)).
Proof:
  f(X, f(f(f(X, f(f(X, Y), f(f(Y, X), X))), X), X))
= { by lemma 12 R->L }
  f(f(X, f(f(X, f(f(X, f(f(X, Y), f(f(Y, X), X))), X)), X)), f(f(f(X, f(f(X, f(f(X, f(f(X, Y), f(f(Y, X), X))), X)), X)), f(f(X, f(f(X, f(f(X, Y), f(f(Y, X), X))), X)), X)), f(X, f(f(X, f(f(X, f(f(X, Y), f(f(Y, X), X))), X)), X))))
= { by lemma 20 }
  f(f(X, f(f(X, f(Y, X)), X)), f(f(f(X, f(f(X, f(f(X, f(f(X, Y), f(f(Y, X), X))), X)), X)), f(f(X, f(f(X, f(f(X, Y), f(f(Y, X), X))), X)), X)), f(X, f(f(X, f(f(X, f(f(X, Y), f(f(Y, X), X))), X)), X))))
= { by lemma 20 }
  f(f(X, f(f(X, f(Y, X)), X)), f(f(f(X, f(f(X, f(Y, X)), X)), f(f(X, f(f(X, f(f(X, Y), f(f(Y, X), X))), X)), X)), f(X, f(f(X, f(f(X, f(f(X, Y), f(f(Y, X), X))), X)), X))))
= { by lemma 20 }
  f(f(X, f(f(X, f(Y, X)), X)), f(f(f(X, f(f(X, f(Y, X)), X)), f(f(X, f(Y, X)), X)), f(X, f(f(X, f(f(X, f(f(X, Y), f(f(Y, X), X))), X)), X))))
= { by lemma 20 }
  f(f(X, f(f(X, f(Y, X)), X)), f(f(f(X, f(f(X, f(Y, X)), X)), f(f(X, f(Y, X)), X)), f(X, f(f(X, f(Y, X)), X))))
= { by lemma 19 }
  f(Z, f(f(Z, f(f(X, f(Y, X)), f(f(f(Y, X), X), Z))), Z))
= { by lemma 20 }
  f(X, f(f(Y, X), X))

Lemma 22: f(f(f(X, f(f(X, X), f(f(X, X), X))), X), X) = f(f(X, X), X).
Proof:
  f(f(f(X, f(f(X, X), f(f(X, X), X))), X), X)
= { by axiom 1 (hyp) }
  f(f(f(f(X, X), f(f(f(X, X), f(X, f(f(X, X), X))), f(f(f(X, f(f(X, X), f(f(X, X), X))), X), X))), f(f(f(X, f(f(X, X), f(f(X, X), X))), X), X)), f(f(f(X, f(f(X, X), X)), f(X, X)), f(X, f(f(X, X), X))))
= { by lemma 6 }
  f(f(f(f(X, X), f(X, f(f(f(X, f(f(X, X), f(f(X, X), X))), X), X))), f(f(f(X, f(f(X, X), f(f(X, X), X))), X), X)), f(f(f(X, f(f(X, X), X)), f(X, X)), f(X, f(f(X, X), X))))
= { by lemma 9 }
