= { by lemma 23 }
  f(f(f(f(f(X, f(f(X, X), f(f(X, X), X))), X), f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X))), f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X)), f(f(f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X)), f(f(X, f(f(X, X), f(f(X, X), X))), X)), f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X))))
= { by lemma 23 }
  f(f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X)), f(f(f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X)), f(f(X, f(f(X, X), f(f(X, X), X))), X)), f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X))))
= { by lemma 16 R->L }
  f(f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X)), f(f(f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X)), f(f(f(f(f(X, f(f(X, X), f(f(X, X), X))), X), X), f(X, f(f(X, f(f(X, f(f(X, X), f(f(X, X), X))), X)), f(f(f(X, f(f(X, X), f(f(X, X), X))), X), X)))), f(f(f(X, f(f(X, X), f(f(X, X), X))), X), X))), f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X))))
= { by lemma 20 }
  f(f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X)), f(f(f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X)), f(f(f(f(f(X, f(f(X, X), f(f(X, X), X))), X), X), f(X, f(f(X, f(X, X)), f(f(f(X, f(f(X, X), f(f(X, X), X))), X), X)))), f(f(f(X, f(f(X, X), f(f(X, X), X))), X), X))), f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X))))
= { by lemma 22 }
  f(f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X)), f(f(f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X)), f(f(f(f(X, X), X), f(X, f(f(X, f(X, X)), f(f(f(X, f(f(X, X), f(f(X, X), X))), X), X)))), f(f(f(X, f(f(X, X), f(f(X, X), X))), X), X))), f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X))))
