= { by lemma 21 }
  f(f(f(f(X, X), f(X, f(f(X, X), X))), f(f(f(X, f(f(X, X), f(f(X, X), X))), X), X)), f(Y, f(f(Y, f(f(X, X), f(X, Y))), Y)))
= { by lemma 6 }
  f(f(X, f(f(f(X, f(f(X, X), f(f(X, X), X))), X), X)), f(Y, f(f(Y, f(f(X, X), f(X, Y))), Y)))
= { by lemma 21 }
  f(f(X, f(f(X, X), X)), f(Y, f(f(Y, f(f(X, X), f(X, Y))), Y)))
= { by lemma 10 }
  f(f(X, X), X)

Lemma 23: f(f(f(f(X, Y), X), f(X, f(f(X, f(X, Y)), X))), f(f(X, f(X, Y)), X)) = f(X, f(f(X, f(X, Y)), X)).
Proof:
  f(f(f(f(X, Y), X), f(X, f(f(X, f(X, Y)), X))), f(f(X, f(X, Y)), X))
= { by lemma 2 R->L }
  f(f(f(f(X, Y), f(f(f(X, Y), f(Y, f(f(Y, X), f(X, Y)))), f(X, Y))), f(X, f(f(X, f(X, Y)), X))), f(f(X, f(X, Y)), X))
= { by lemma 14 R->L }
  f(f(f(f(X, Y), f(f(f(X, Y), X), f(X, f(f(X, f(f(f(Y, f(f(Y, X), f(X, Y))), f(X, Y)), f(f(X, Y), X))), X)))), f(X, f(f(X, f(X, Y)), X))), f(f(X, f(X, Y)), X))
= { by axiom 1 (hyp) R->L }
  f(f(f(f(X, Y), f(f(f(X, Y), X), f(X, f(f(X, f(X, Y)), X)))), f(X, f(f(X, f(X, Y)), X))), f(f(X, f(X, Y)), X))
= { by axiom 1 (hyp) R->L }
  f(X, f(f(X, f(X, Y)), X))

Lemma 24: f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X) = f(f(X, X), X).
Proof:
  f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X)
