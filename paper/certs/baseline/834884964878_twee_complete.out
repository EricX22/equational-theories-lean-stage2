  f(f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X)), f(f(f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X)), f(X, X)), f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X))))
= { by lemma 19 }
  f(X, f(f(X, f(X, f(f(f(X, f(f(X, X), f(f(X, X), X))), X), X))), X))
