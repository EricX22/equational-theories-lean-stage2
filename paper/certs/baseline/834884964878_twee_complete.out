= { by lemma 22 }
  f(f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X)), f(f(f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X)), f(f(f(f(X, X), X), f(X, f(f(X, f(X, X)), f(f(X, X), X)))), f(f(X, X), X))), f(X, f(f(X, f(X, f(f(X, X), f(f(X, X), X)))), X))))
