Goal 1 (goal): x = y.
Proof:
  x
= { by lemma 35 R->L }
  f(y, f(x, y))
= { by lemma 35 R->L }
  f(y, f(f(y, f(x, y)), y))
= { by lemma 40 R->L }
  f(y, f(f(y, f(f(y, f(f(x, f(x, y)), y)), y)), y))
= { by lemma 36 R->L }
  f(f(f(x, f(x, y)), y), f(f(f(f(x, f(x, y)), y), f(f(y, f(f(x, f(x, y)), y)), f(y, f(f(x, f(x, y)), y)))), f(f(x, f(x, y)), y)))
= { by lemma 31 }
  f(f(f(x, f(x, y)), y), f(f(f(f(x, f(x, y)), y), f(y, f(f(x, f(x, y)), y))), f(f(x, f(x, y)), y)))
= { by lemma 40 }
  f(f(f(x, f(x, y)), y), f(f(f(f(x, f(x, y)), y), x), f(f(x, f(x, y)), y)))
= { by lemma 32 }
  f(f(f(x, f(x, y)), y), f(y, f(f(x, f(x, y)), y)))
= { by lemma 40 }
  f(f(f(x, f(x, y)), y), x)
= { by lemma 32 }
  y
