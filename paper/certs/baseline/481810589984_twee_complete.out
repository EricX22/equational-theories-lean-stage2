= { by lemma 7 R->L }
  f(f(X, f(f(f(f(X, X), X), X), f(f(f(X, Y), f(f(X, X), f(f(f(X, X), f(f(X, X), X)), f(X, f(X, X))))), f(Y, f(X, X))))), f(f(f(X, X), f(f(X, X), X)), f(X, f(X, X))))
= { by lemma 7 R->L }
  f(f(X, f(f(f(f(X, X), X), X), f(f(f(f(f(f(X, X), f(f(X, X), X)), f(X, f(X, X))), Y), f(f(X, X), f(f(f(X, X), f(f(X, X), X)), f(X, f(X, X))))), f(Y, f(X, X))))), f(f(f(X, X), f(f(X, X), X)), f(X, f(X, X))))
= { by lemma 2 R->L }
  f(f(f(f(f(f(f(X, X), f(f(X, X), X)), f(X, f(X, X))), f(f(f(X, X), X), X)), f(X, X)), f(f(f(f(X, X), X), X), f(f(f(f(f(f(X, X), f(f(X, X), X)), f(X, f(X, X))), Y), f(f(X, X), f(f(f(X, X), f(f(X, X), X)), f(X, f(X, X))))), f(Y, f(X, X))))), f(f(f(X, X), f(f(X, X), X)), f(X, f(X, X))))
= { by lemma 2 R->L }
  f(f(f(f(f(f(f(X, X), f(f(X, X), X)), f(X, f(X, X))), f(f(f(X, X), X), X)), f(f(f(f(f(f(f(X, X), f(f(X, X), X)), f(X, f(X, X))), Y), f(f(X, X), f(f(f(X, X), f(f(X, X), X)), f(X, f(X, X))))), f(Y, f(X, X))), f(f(f(X, X), f(f(X, X), X)), f(X, f(X, X))))), f(f(f(f(X, X), X), X), f(f(f(f(f(f(X, X), f(f(X, X), X)), f(X, f(X, X))), Y), f(f(X, X), f(f(f(X, X), f(f(X, X), X)), f(X, f(X, X))))), f(Y, f(X, X))))), f(f(f(X, X), f(f(X, X), X)), f(X, f(X, X))))
= { by lemma 2 }
  f(f(f(f(f(f(X, X), f(f(X, X), X)), f(X, f(X, X))), Y), f(f(X, X), f(f(f(X, X), f(f(X, X), X)), f(X, f(X, X))))), f(Y, f(X, X)))
= { by lemma 7 }
