= { by lemma 8 R->L }
  f(f(f(X, X), X), f(f(f(X, Y), f(f(f(X, f(f(f(f(X, X), X), X), X)), X), X)), f(Y, f(f(X, f(f(f(f(X, X), X), X), X)), X))))
= { by lemma 7 }
  f(f(f(X, X), X), f(X, f(f(f(f(X, X), X), X), X)))
= { by lemma 7 R->L }
  f(f(f(f(X, Z), f(f(f(f(X, X), X), X), X)), f(Z, f(f(f(X, X), X), X))), f(X, f(f(f(f(X, X), X), X), X)))
= { by lemma 12 R->L }
  f(f(f(f(X, Z), f(f(f(f(X, X), X), X), X)), f(Z, f(f(f(X, X), f(f(f(f(f(X, X), X), X), X), X)), X))), f(X, f(f(f(f(X, X), X), X), X)))
= { by lemma 12 R->L }
  f(f(f(f(X, Z), f(f(f(f(X, X), f(f(f(f(f(X, X), X), X), X), X)), X), X)), f(Z, f(f(f(X, X), f(f(f(f(f(X, X), X), X), X), X)), X))), f(X, f(f(f(f(X, X), X), X), X)))
= { by lemma 7 }
  f(f(f(X, X), f(f(f(f(f(X, X), X), X), X), X)), f(X, f(f(f(f(X, X), X), X), X)))
= { by lemma 13 R->L }
  f(f(f(X, W), f(f(f(f(f(X, X), X), X), X), X)), f(W, f(f(f(f(X, X), X), X), X)))
= { by lemma 7 }
  f(f(f(X, X), X), X)

Lemma 15: f(f(f(f(X, X), X), X), f(X, f(f(X, X), f(X, X)))) = f(X, X).
Proof:
  f(f(f(f(X, X), X), X), f(X, f(f(X, X), f(X, X))))
= { by lemma 14 R->L }
  f(f(f(f(X, X), X), f(f(f(X, X), f(X, X)), f(X, X))), f(X, f(f(X, X), f(X, X))))
= { by lemma 7 }
  f(X, X)

Lemma 16: f(f(X, f(X, f(f(X, X), f(X, X)))), f(X, X)) = X.
Proof:
  f(f(X, f(X, f(f(X, X), f(X, X)))), f(X, X))
= { by lemma 7 R->L }
