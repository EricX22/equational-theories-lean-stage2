= { by lemma 15 R->L }
  f(f(f(f(f(X, X), f(f(X, X), X)), f(X, f(f(f(f(X, X), X), X), f(X, f(f(X, X), f(X, X)))))), f(X, f(f(X, X), f(X, X)))), f(X, X))
= { by lemma 15 R->L }
  f(f(f(f(f(X, X), f(f(X, X), X)), f(X, f(f(f(f(X, X), X), X), f(X, f(f(X, X), f(X, X)))))), f(X, f(f(X, X), f(X, X)))), f(f(f(f(X, X), X), X), f(X, f(f(X, X), f(X, X)))))
= { by lemma 15 R->L }
  f(f(f(f(f(f(f(f(X, X), X), X), f(X, f(f(X, X), f(X, X)))), f(f(X, X), X)), f(X, f(f(f(f(X, X), X), X), f(X, f(f(X, X), f(X, X)))))), f(X, f(f(X, X), f(X, X)))), f(f(f(f(X, X), X), X), f(X, f(f(X, X), f(X, X)))))
= { by lemma 6 }
  X

Lemma 17: f(f(X, f(f(X, X), X)), X) = X.
Proof:
  f(f(X, f(f(X, X), X)), X)
= { by lemma 16 R->L }
  f(f(f(f(X, f(X, f(f(X, X), f(X, X)))), f(X, X)), f(f(X, X), X)), X)
= { by axiom 1 (hyp) R->L }
  X

Lemma 18: f(f(f(X, X), f(f(f(X, X), X), X)), X) = f(X, X).
Proof:
  f(f(f(X, X), f(f(f(X, X), X), X)), X)
= { by lemma 17 R->L }
