= { by lemma 7 R->L }
  f(f(f(f(f(X, f(f(X, X), X)), X), Y), f(f(f(f(f(f(f(X, f(f(X, X), X)), X), X), f(f(f(X, X), X), f(f(X, f(f(X, X), X)), X))), X), f(f(X, f(f(X, X), X)), X)), f(f(X, f(f(X, X), X)), X))), f(Y, f(f(f(f(f(f(X, f(f(X, X), X)), X), X), f(f(f(X, X), X), f(f(X, f(f(X, X), X)), X))), X), f(f(X, f(f(X, X), X)), X))))
= { by lemma 6 }
  f(f(f(f(f(X, f(f(X, X), X)), X), Y), f(f(f(X, X), X), f(f(X, f(f(X, X), X)), X))), f(Y, f(f(f(f(f(f(X, f(f(X, X), X)), X), X), f(f(f(X, X), X), f(f(X, f(f(X, X), X)), X))), X), f(f(X, f(f(X, X), X)), X))))
= { by lemma 6 }
  f(f(f(f(f(X, f(f(X, X), X)), X), Y), f(f(f(X, X), X), f(f(X, f(f(X, X), X)), X))), f(Y, f(f(X, X), X)))
= { by lemma 17 }
  f(f(f(X, Y), f(f(f(X, X), X), f(f(X, f(f(X, X), X)), X))), f(Y, f(f(X, X), X)))
= { by lemma 17 }
  f(f(f(X, Y), f(f(f(X, X), X), X)), f(Y, f(f(X, X), X)))
= { by lemma 7 }
