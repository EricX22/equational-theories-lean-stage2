  f(f(f(f(f(f(X, X), f(f(f(X, Y), X), X)), f(X, f(f(X, f(X, Y)), X))), f(f(f(X, X), X), X)), X), X)
= { by lemma 34 R->L }
  f(f(f(f(f(f(X, X), f(f(f(X, f(X, Y)), X), X)), f(X, f(f(X, f(X, Y)), X))), f(f(f(X, X), X), X)), X), X)
= { by lemma 7 }
  f(f(f(f(X, f(X, Y)), f(f(f(X, X), X), X)), X), X)
= { by lemma 29 R->L }
  f(f(f(f(X, f(f(X, X), Y)), f(f(f(X, X), X), X)), X), X)
= { by lemma 29 R->L }
  f(f(f(f(X, f(f(X, X), Y)), f(f(f(f(X, X), X), X), X)), X), X)
= { by lemma 29 R->L }
  f(f(f(f(X, f(f(X, X), Y)), f(f(f(f(X, X), X), X), X)), f(X, X)), X)
= { by lemma 19 R->L }
  f(f(f(f(X, f(f(X, f(f(X, X), f(f(f(X, X), X), X))), Y)), f(f(f(f(X, X), X), X), X)), f(X, X)), X)
= { by lemma 31 R->L }
  f(f(f(f(X, f(f(f(f(f(X, X), X), f(X, X)), f(f(X, X), f(f(f(X, X), X), X))), Y)), f(f(f(f(X, X), X), X), X)), f(X, X)), X)
= { by lemma 29 R->L }
  f(f(f(f(X, f(f(f(f(f(f(X, X), X), X), f(X, X)), f(f(X, X), f(f(f(X, X), X), X))), Y)), f(f(f(f(X, X), X), X), X)), f(X, X)), X)
= { by lemma 4 R->L }
  f(f(f(f(X, f(f(f(f(f(f(X, X), X), X), f(X, X)), f(f(X, X), f(f(f(X, X), X), X))), Y)), f(f(f(f(X, X), X), X), X)), f(f(f(f(f(f(f(X, X), X), X), f(X, X)), f(f(X, X), f(f(f(X, X), X), X))), X), f(f(f(X, X), X), X))), X)
= { by axiom 1 (hyp) R->L }
  f(f(f(X, X), X), X)
= { by lemma 28 }
  f(f(X, X), X)
= { by lemma 28 }
  f(X, X)
= { by lemma 29 }
  X

Lemma 36: f(f(X, Y), X) = X.
Proof:
  f(f(X, Y), X)
= { by lemma 30 R->L }
  f(f(X, f(f(f(f(X, Y), X), X), X)), f(X, f(f(f(X, Y), X), X)))
= { by lemma 29 R->L }
  f(f(f(X, X), f(f(f(f(X, Y), X), X), X)), f(X, f(f(f(X, Y), X), X)))
= { by lemma 29 R->L }
  f(f(f(X, X), f(f(f(f(X, Y), X), X), f(X, X))), f(X, f(f(f(X, Y), X), X)))
= { by lemma 28 R->L }
  f(f(f(f(X, X), X), f(f(f(f(X, Y), X), X), f(X, X))), f(X, f(f(f(X, Y), X), X)))
= { by lemma 35 R->L }
  f(f(f(f(X, f(f(f(f(X, Y), X), X), X)), X), f(f(f(f(X, Y), X), X), f(X, X))), f(X, f(f(f(X, Y), X), X)))
= { by lemma 35 R->L }
  f(f(f(f(X, f(f(f(f(X, Y), X), X), X)), X), f(f(f(f(X, Y), X), X), f(X, f(f(f(f(X, Y), X), X), X)))), f(X, f(f(f(X, Y), X), X)))
= { by lemma 23 }
  f(f(X, X), f(f(f(f(f(X, Y), X), X), X), X))
= { by lemma 35 }
  f(f(X, X), f(X, X))
= { by lemma 25 }
  X

Goal 1 (goal): x = y.
Proof:
  x
= { by lemma 6 R->L }
  f(f(f(f(f(f(X, x), X), X), f(x, f(f(X, x), X))), X), f(f(X, x), X))
= { by lemma 36 }
  f(f(f(f(X, X), f(x, f(f(X, x), X))), X), f(f(X, x), X))
= { by lemma 29 }
  f(f(f(X, f(x, f(f(X, x), X))), X), f(f(X, x), X))
= { by lemma 36 }
  f(X, f(f(X, x), X))
= { by lemma 36 }
  f(X, X)
= { by lemma 36 R->L }
  f(X, f(f(X, y), X))
= { by lemma 36 R->L }
  f(f(f(X, f(y, f(f(X, y), X))), X), f(f(X, y), X))
= { by lemma 29 R->L }
  f(f(f(f(X, X), f(y, f(f(X, y), X))), X), f(f(X, y), X))
= { by lemma 36 R->L }
  f(f(f(f(f(f(X, y), X), X), f(y, f(f(X, y), X))), X), f(f(X, y), X))
= { by lemma 6 }
  y
% SZS output end Proof

RESULT: Theorem (the conjecture is true).
