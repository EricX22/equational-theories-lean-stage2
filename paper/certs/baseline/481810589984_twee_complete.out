= { by lemma 2 R->L }
  f(f(f(f(X, f(f(Y, Z), f(X, Y))), f(f(Z, X), f(f(f(f(Y, Z), f(X, Y)), f(Z, X)), Y))), Y), f(f(f(f(Y, Z), f(X, Y)), f(Z, X)), Y))
