  f(f(f(f(X, f(f(f(f(f(f(f(X, W), f(Z, X)), f(W, Z)), X), f(f(f(X, Y), f(f(Z, X), X)), f(Y, f(Z, X)))), f(f(f(X, W), f(Z, X)), f(W, Z))), f(X, f(f(f(f(f(X, W), f(Z, X)), f(W, Z)), X), f(f(f(X, Y), f(f(Z, X), X)), f(Y, f(Z, X))))))), f(Z, f(f(f(f(f(f(f(f(f(X, W), f(Z, X)), f(W, Z)), X), f(f(f(X, Y), f(f(Z, X), X)), f(Y, f(Z, X)))), f(f(f(X, W), f(Z, X)), f(W, Z))), f(X, f(f(f(f(f(X, W), f(Z, X)), f(W, Z)), X), f(f(f(X, Y), f(f(Z, X), X)), f(Y, f(Z, X)))))), Z), f(f(f(f(f(X, W), f(Z, X)), f(W, Z)), X), f(f(f(X, Y), f(f(Z, X), X)), f(Y, f(Z, X))))))), f(f(f(f(f(X, W), f(Z, X)), f(W, Z)), X), f(f(f(X, Y), f(f(Z, X), X)), f(Y, f(Z, X))))), f(f(f(f(f(f(f(f(f(X, W), f(Z, X)), f(W, Z)), X), f(f(f(X, Y), f(f(Z, X), X)), f(Y, f(Z, X)))), f(f(f(X, W), f(Z, X)), f(W, Z))), f(X, f(f(f(f(f(X, W), f(Z, X)), f(W, Z)), X), f(f(f(X, Y), f(f(Z, X), X)), f(Y, f(Z, X)))))), Z), f(f(f(f(f(X, W), f(Z, X)), f(W, Z)), X), f(f(f(X, Y), f(f(Z, X), X)), f(Y, f(Z, X))))))
