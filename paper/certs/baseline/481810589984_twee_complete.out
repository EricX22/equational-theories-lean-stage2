Lemma 19: f(f(X, X), f(f(f(X, X), X), X)) = X.
Proof:
  f(f(X, X), f(f(f(X, X), X), X))
= { by lemma 7 R->L }
  f(f(f(X, Y), f(f(f(f(X, X), f(f(f(X, X), X), X)), X), X)), f(Y, f(f(f(X, X), f(f(f(X, X), X), X)), X)))
= { by lemma 18 }
  f(f(f(X, Y), f(f(X, X), X)), f(Y, f(f(f(X, X), f(f(f(X, X), X), X)), X)))
= { by lemma 18 }
  f(f(f(X, Y), f(f(X, X), X)), f(Y, f(X, X)))
= { by lemma 7 }
  X

Lemma 20: f(X, f(X, f(f(X, X), X))) = f(X, X).
Proof:
  f(X, f(X, f(f(X, X), X)))
= { by lemma 19 R->L }
  f(f(f(X, X), f(f(f(X, X), X), X)), f(X, f(f(X, X), X)))
= { by lemma 7 }
  f(X, X)

Lemma 21: f(f(f(X, Y), f(X, X)), f(Y, X)) = f(X, f(f(X, X), X)).
Proof:
  f(f(f(X, Y), f(X, X)), f(Y, X))
= { by axiom 1 (hyp) }
  f(f(f(X, Y), f(X, X)), f(Y, f(f(f(f(X, f(X, f(f(X, X), f(X, X)))), f(X, X)), f(f(X, X), X)), X)))
= { by axiom 1 (hyp) }
  f(f(f(X, Y), f(f(f(f(f(X, f(X, f(f(X, X), f(X, X)))), f(X, X)), f(f(X, X), X)), X), X)), f(Y, f(f(f(f(X, f(X, f(f(X, X), f(X, X)))), f(X, X)), f(f(X, X), X)), X)))
= { by lemma 7 }
  f(f(f(X, f(X, f(f(X, X), f(X, X)))), f(X, X)), f(f(X, X), X))
= { by lemma 16 }
  f(X, f(f(X, X), X))

Lemma 22: f(f(X, f(f(f(X, X), X), X)), X) = f(X, f(f(X, X), X)).
Proof:
  f(f(X, f(f(f(X, X), X), X)), X)
= { by lemma 14 R->L }
  f(f(X, f(f(f(X, X), X), f(f(f(X, f(Y, X)), f(X, X)), f(f(Y, X), X)))), X)
= { by lemma 17 R->L }
  f(f(f(f(X, f(f(X, X), X)), X), f(f(f(X, X), X), f(f(f(X, f(Y, X)), f(X, X)), f(f(Y, X), X)))), X)
= { by axiom 1 (hyp) }
  f(f(f(f(X, f(f(X, X), X)), f(f(f(f(X, f(Y, X)), f(X, X)), f(f(Y, X), X)), X)), f(f(f(X, X), X), f(f(f(X, f(Y, X)), f(X, X)), f(f(Y, X), X)))), X)
= { by lemma 2 }
  f(f(f(X, f(Y, X)), f(X, X)), f(f(Y, X), X))
= { by lemma 21 }
