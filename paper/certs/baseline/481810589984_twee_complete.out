= { by lemma 6 }
  Z

Lemma 8: f(f(X, f(f(f(f(X, X), X), X), X)), X) = X.
Proof:
  f(f(X, f(f(f(f(X, X), X), X), X)), X)
= { by lemma 7 R->L }
