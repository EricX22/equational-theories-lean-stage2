Lemma 17: f(X, X) = X.
Proof:
  f(X, X)
= { by axiom 1 (hyp) }
  f(X, f(Y, f(X, f(Y, f(f(Z, X), f(f(W, Z), Z))))))
= { by axiom 1 (hyp) }
  f(f(Y, f(X, f(Y, f(f(Z, X), f(f(W, Z), Z))))), f(Y, f(X, f(Y, f(f(Z, X), f(f(W, Z), Z))))))
= { by lemma 16 }
  f(Y, f(X, f(Y, f(f(Z, X), f(f(W, Z), Z)))))
= { by axiom 1 (hyp) R->L }
  X

Lemma 18: f(f(X, Y), Y) = Y.
Proof:
  f(f(X, Y), Y)
= { by lemma 17 R->L }
  f(f(X, Y), f(Y, Y))
= { by lemma 17 R->L }
  f(f(X, f(Y, Y)), f(Y, Y))
= { by lemma 17 R->L }
  f(f(X, f(Y, Y)), f(f(Y, Y), Y))
= { by lemma 17 R->L }
  f(f(X, f(Y, Y)), f(f(Y, Y), f(Y, Y)))
= { by lemma 17 R->L }
  f(f(X, f(f(Y, Y), f(Y, Y))), f(f(Y, Y), f(Y, Y)))
= { by lemma 17 R->L }
  f(f(X, f(f(Y, Y), f(Y, Y))), f(f(f(Y, Y), f(Y, Y)), f(Y, Y)))
= { by lemma 17 R->L }
