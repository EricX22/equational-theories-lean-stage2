= { by lemma 11 R->L }
  f(f(X, f(f(f(Y, Y), f(f(f(Y, Y), f(Y, Y)), f(Y, Y))), f(f(f(Y, Y), f(Y, Y)), f(Y, Y)))), f(f(f(f(f(Y, Y), f(Y, Y)), f(Y, Y)), f(f(f(f(Y, Y), f(Y, Y)), f(Y, Y)), f(f(f(Y, Y), f(Y, Y)), f(Y, Y)))), f(f(f(Y, Y), f(Y, Y)), f(Y, Y))))
