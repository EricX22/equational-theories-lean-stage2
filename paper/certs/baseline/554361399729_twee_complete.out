= { by lemma 2 R->L }
  f(f(X, f(f(Y, f(f(Z, f(Z, Z)), W)), f(Y, f(f(Z, f(Z, Z)), W)))), f(f(f(f(Z, f(Z, Z)), X), f(f(f(f(f(f(f(Z, f(Z, Z)), W), Z), f(f(W, Y), f(Z, f(f(Z, f(Z, Z)), W)))), Z), f(f(Y, f(f(Z, f(Z, Z)), W)), f(Y, f(f(Z, f(Z, Z)), W)))), f(f(Z, f(f(f(Y, f(f(Z, f(Z, Z)), W)), f(Z, f(Z, Z))), f(f(Y, f(f(Z, f(Z, Z)), W)), f(Z, f(Z, Z))))), f(f(f(f(f(Z, f(Z, Z)), W), Z), f(f(W, Y), f(Z, f(f(Z, f(Z, Z)), W)))), Z)))), X))
= { by lemma 3 }
  f(f(X, f(f(Y, f(f(Z, f(Z, Z)), W)), f(Y, f(f(Z, f(Z, Z)), W)))), f(f(f(f(Z, f(Z, Z)), X), f(f(f(f(f(f(f(Z, f(Z, Z)), W), Z), f(f(W, Y), f(Z, f(f(Z, f(Z, Z)), W)))), Z), f(f(Y, f(f(Z, f(Z, Z)), W)), f(Y, f(f(Z, f(Z, Z)), W)))), f(f(Y, f(f(Z, f(Z, Z)), W)), f(Z, f(Z, Z))))), X))
= { by axiom 1 (hyp) R->L }
