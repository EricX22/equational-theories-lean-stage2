  f(f(X, f(f(f(Y, Z), W), f(f(Y, Z), W))), f(f(f(Z, X), f(f(V, Y), f(U, f(W, V)))), X))
= { by axiom 1 (hyp) }
  f(f(X, f(f(f(Y, Z), W), f(f(Y, Z), f(f(Y, f(W, W)), f(f(f(V, Y), f(U, f(W, V))), Y))))), f(f(f(Z, X), f(f(V, Y), f(U, f(W, V)))), X))
= { by axiom 1 (hyp) }
  f(f(X, f(f(f(Y, Z), f(f(Y, f(W, W)), f(f(f(V, Y), f(U, f(W, V))), Y))), f(f(Y, Z), f(f(Y, f(W, W)), f(f(f(V, Y), f(U, f(W, V))), Y))))), f(f(f(Z, X), f(f(V, Y), f(U, f(W, V)))), X))
= { by axiom 1 (hyp) }
  f(f(X, f(f(f(Y, Z), f(f(Y, f(W, W)), f(f(f(V, Y), f(U, f(W, V))), Y))), f(f(Y, Z), f(f(Y, f(W, W)), f(f(f(V, Y), f(U, f(W, V))), Y))))), f(f(f(Z, X), f(f(Z, f(f(f(V, Y), f(U, f(W, V))), f(f(V, Y), f(U, f(W, V))))), f(f(f(Y, Z), f(f(Y, f(W, W)), f(f(f(V, Y), f(U, f(W, V))), Y))), Z))), X))
= { by axiom 1 (hyp) R->L }
  f(f(Y, Z), f(f(Y, f(W, W)), f(f(f(V, Y), f(U, f(W, V))), Y)))
= { by axiom 1 (hyp) R->L }
  f(f(Y, Z), W)

Lemma 4: f(f(X, f(f(Y, f(f(Z, f(Z, Z)), W)), f(Y, f(f(Z, f(Z, Z)), W)))), f(f(f(f(Z, f(Z, Z)), X), f(Y, f(f(Z, f(Z, Z)), W))), X)) = f(Y, f(f(Z, f(Z, Z)), W)).
