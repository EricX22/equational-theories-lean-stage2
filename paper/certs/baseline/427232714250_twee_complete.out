= { by lemma 22 }
  f(f(Y, Y), f(f(f(f(Y, Y), Y), f(f(Y, Y), Y)), f(f(f(Y, Y), Y), f(f(Y, Y), Y))))
= { by lemma 24 }
  f(f(Y, Y), f(f(f(Y, Y), f(f(Y, Y), Y)), f(f(f(Y, Y), Y), f(f(Y, Y), Y))))
= { by lemma 24 }
