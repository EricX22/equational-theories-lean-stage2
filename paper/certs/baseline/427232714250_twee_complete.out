= { by lemma 22 }
  f(f(Y, Y), Y)
= { by lemma 24 }
  f(Y, Y)

Lemma 26: f(X, X) = Y.
Proof:
  f(X, X)
= { by lemma 24 R->L }
  f(f(X, X), X)
= { by lemma 22 R->L }
  f(f(X, X), f(X, X))
= { by lemma 25 R->L }
  f(f(Y, f(Y, Y)), f(X, X))
= { by lemma 25 R->L }
  f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))
= { by lemma 25 R->L }
  f(f(Y, f(Z, f(Z, Z))), f(Y, f(Y, Y)))
= { by lemma 25 R->L }
  f(f(Y, f(Z, f(Z, Z))), f(Y, f(Z, f(Z, Z))))
= { by lemma 24 R->L }
  f(f(Y, f(Z, f(f(Z, Z), Z))), f(Y, f(Z, f(Z, Z))))
= { by lemma 24 R->L }
