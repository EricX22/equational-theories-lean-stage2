= { by lemma 22 R->L }
  f(f(Y, f(Z, f(f(Z, Z), f(Z, Z)))), f(Y, f(Z, f(f(Z, Z), Z))))
= { by lemma 22 R->L }
  f(f(Y, f(Z, f(f(Z, Z), f(Z, Z)))), f(Y, f(Z, f(f(Z, Z), f(Z, Z)))))
= { by lemma 24 R->L }
  f(f(Y, f(Z, f(f(f(Z, Z), Z), f(Z, Z)))), f(Y, f(Z, f(f(Z, Z), f(Z, Z)))))
= { by lemma 24 R->L }
  f(f(Y, f(Z, f(f(f(Z, Z), Z), f(f(Z, Z), Z)))), f(Y, f(Z, f(f(Z, Z), f(Z, Z)))))
= { by lemma 24 R->L }
  f(f(Y, f(Z, f(f(f(Z, Z), Z), f(f(Z, Z), Z)))), f(Y, f(Z, f(f(f(Z, Z), Z), f(Z, Z)))))
= { by lemma 24 R->L }
  f(f(Y, f(Z, f(f(f(Z, Z), Z), f(f(Z, Z), Z)))), f(Y, f(Z, f(f(f(Z, Z), Z), f(f(Z, Z), Z)))))
= { by lemma 22 R->L }
  f(f(Y, f(Z, f(f(f(Z, Z), f(Z, Z)), f(f(Z, Z), Z)))), f(Y, f(Z, f(f(f(Z, Z), Z), f(f(Z, Z), Z)))))
= { by lemma 22 R->L }
  f(f(Y, f(Z, f(f(f(Z, Z), f(Z, Z)), f(f(Z, Z), f(Z, Z))))), f(Y, f(Z, f(f(f(Z, Z), Z), f(f(Z, Z), Z)))))
= { by lemma 22 R->L }
  f(f(Y, f(Z, f(f(f(Z, Z), f(Z, Z)), f(f(Z, Z), f(Z, Z))))), f(Y, f(Z, f(f(f(Z, Z), f(Z, Z)), f(f(Z, Z), Z)))))
= { by lemma 22 R->L }
  f(f(Y, f(Z, f(f(f(Z, Z), f(Z, Z)), f(f(Z, Z), f(Z, Z))))), f(Y, f(Z, f(f(f(Z, Z), f(Z, Z)), f(f(Z, Z), f(Z, Z))))))
= { by lemma 18 R->L }
  f(f(Y, f(Z, f(f(f(Z, Z), f(Z, Z)), f(f(Z, Z), f(Z, Z))))), f(Y, f(f(Y, f(Z, f(f(f(Z, Z), f(Z, Z)), f(f(Z, Z), f(Z, Z))))), f(Y, Y))))
= { by lemma 24 R->L }
  f(f(Y, f(Z, f(f(f(Z, Z), f(Z, Z)), f(f(Z, Z), f(Z, Z))))), f(Y, f(f(Y, f(Z, f(f(f(Z, Z), f(Z, Z)), f(f(Z, Z), f(Z, Z))))), f(f(Y, Y), Y))))
= { by lemma 23 }
  Y

Lemma 27: f(X, f(Y, f(X, Z))) = W.
Proof:
  f(X, f(Y, f(X, Z)))
= { by lemma 26 R->L }
  f(X, f(f(V, V), f(X, Z)))
= { by lemma 26 R->L }
  f(X, f(f(V, V), f(X, f(U, U))))
= { by lemma 25 R->L }
  f(X, f(f(T, f(T, T)), f(X, f(U, U))))
= { by lemma 25 R->L }
  f(X, f(f(T, f(T, T)), f(X, f(T, f(T, T)))))
= { by lemma 24 R->L }
  f(X, f(f(T, f(f(T, T), T)), f(X, f(T, f(T, T)))))
= { by lemma 22 R->L }
  f(X, f(f(T, f(f(T, T), f(T, T))), f(X, f(T, f(T, T)))))
= { by lemma 25 R->L }
  f(X, f(f(T, f(f(S, f(S, S)), f(T, T))), f(X, f(T, f(T, T)))))
= { by lemma 25 R->L }
  f(X, f(f(T, f(f(S, f(S, S)), f(T, f(T, T)))), f(X, f(T, f(T, T)))))
= { by lemma 25 R->L }
  f(X, f(f(T, f(f(S, f(S, S)), f(T, f(T, T)))), f(X, f(T, f(S, f(S, S))))))
= { by lemma 24 R->L }
  f(X, f(f(T, f(f(S, f(f(S, S), S)), f(T, f(T, T)))), f(X, f(T, f(S, f(S, S))))))
= { by lemma 24 R->L }
  f(X, f(f(T, f(f(S, f(f(S, S), S)), f(T, f(T, T)))), f(X, f(T, f(S, f(f(S, S), S))))))
= { by lemma 22 R->L }
  f(X, f(f(T, f(f(S, f(f(S, S), f(S, S))), f(T, f(T, T)))), f(X, f(T, f(S, f(f(S, S), S))))))
= { by lemma 22 R->L }
  f(X, f(f(T, f(f(S, f(f(S, S), f(S, S))), f(T, f(T, T)))), f(X, f(T, f(S, f(f(S, S), f(S, S)))))))
= { by lemma 24 R->L }
  f(X, f(f(T, f(f(S, f(f(f(S, S), S), f(S, S))), f(T, f(T, T)))), f(X, f(T, f(S, f(f(S, S), f(S, S)))))))
= { by lemma 24 R->L }
  f(X, f(f(T, f(f(S, f(f(f(S, S), S), f(f(S, S), S))), f(T, f(T, T)))), f(X, f(T, f(S, f(f(S, S), f(S, S)))))))
= { by lemma 24 R->L }
  f(X, f(f(T, f(f(S, f(f(f(S, S), S), f(f(S, S), S))), f(T, f(T, T)))), f(X, f(T, f(S, f(f(f(S, S), S), f(S, S)))))))
= { by lemma 24 R->L }
  f(X, f(f(T, f(f(S, f(f(f(S, S), S), f(f(S, S), S))), f(T, f(T, T)))), f(X, f(T, f(S, f(f(f(S, S), S), f(f(S, S), S)))))))
= { by lemma 22 R->L }
  f(X, f(f(T, f(f(S, f(f(f(S, S), f(S, S)), f(f(S, S), S))), f(T, f(T, T)))), f(X, f(T, f(S, f(f(f(S, S), S), f(f(S, S), S)))))))
= { by lemma 22 R->L }
  f(X, f(f(T, f(f(S, f(f(f(S, S), f(S, S)), f(f(S, S), f(S, S)))), f(T, f(T, T)))), f(X, f(T, f(S, f(f(f(S, S), S), f(f(S, S), S)))))))
= { by lemma 22 R->L }
  f(X, f(f(T, f(f(S, f(f(f(S, S), f(S, S)), f(f(S, S), f(S, S)))), f(T, f(T, T)))), f(X, f(T, f(S, f(f(f(S, S), f(S, S)), f(f(S, S), S)))))))
= { by lemma 22 R->L }
  f(X, f(f(T, f(f(S, f(f(f(S, S), f(S, S)), f(f(S, S), f(S, S)))), f(T, f(T, T)))), f(X, f(T, f(S, f(f(f(S, S), f(S, S)), f(f(S, S), f(S, S))))))))
= { by lemma 26 R->L }
  f(X, f(f(T, f(f(S, f(f(f(S, S), f(S, S)), f(f(S, S), f(S, S)))), f(f(T, T), f(T, T)))), f(X, f(T, f(S, f(f(f(S, S), f(S, S)), f(f(S, S), f(S, S))))))))
= { by lemma 10 }
  f(T, f(f(S, f(f(f(S, S), f(S, S)), f(f(S, S), f(S, S)))), f(f(T, T), f(T, T))))
= { by lemma 22 }
  f(T, f(f(S, f(f(f(S, S), S), f(f(S, S), f(S, S)))), f(f(T, T), f(T, T))))
= { by lemma 22 }
  f(T, f(f(S, f(f(f(S, S), S), f(f(S, S), S))), f(f(T, T), f(T, T))))
= { by lemma 22 }
  f(T, f(f(S, f(f(f(S, S), S), f(f(S, S), S))), f(f(T, T), T)))
= { by lemma 24 }
  f(T, f(f(S, f(f(S, S), f(f(S, S), S))), f(f(T, T), T)))
= { by lemma 24 }
  f(T, f(f(S, f(f(S, S), f(S, S))), f(f(T, T), T)))
= { by lemma 24 }
  f(T, f(f(S, f(f(S, S), f(S, S))), f(T, T)))
= { by lemma 22 }
  f(T, f(f(S, f(f(S, S), S)), f(T, T)))
= { by lemma 24 }
  f(T, f(f(S, f(S, S)), f(T, T)))
= { by lemma 25 }
  f(T, f(f(T, T), f(T, T)))
= { by lemma 22 }
  f(T, f(f(T, T), T))
= { by lemma 24 }
  f(T, f(T, T))
= { by lemma 25 }
  f(X2, X2)
= { by lemma 26 }
  W

Lemma 28: f(X, f(f(Y, Z), W)) = V.
Proof:
  f(X, f(f(Y, Z), W))
= { by lemma 27 R->L }
  f(X, f(f(f(U, f(T, f(U, S))), Z), W))
= { by lemma 26 R->L }
