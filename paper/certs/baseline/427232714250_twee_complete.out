= { by lemma 22 R->L }
  f(X, f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))))
= { by lemma 21 }
  f(f(Y, Y), f(f(f(f(Y, Y), f(Y, Y)), f(f(Y, Y), f(Y, Y))), f(f(f(Y, Y), f(Y, Y)), f(f(Y, Y), f(Y, Y)))))
