= { by lemma 25 }
  f(X, X)
= { by lemma 25 R->L }
  f(X, f(f(f(W, V), y), X))
= { by lemma 23 R->L }
  f(X, f(f(f(W, V), y), f(X, X)))
= { by lemma 25 R->L }
  f(X, f(f(f(W, V), y), f(X, f(y, X))))
= { by lemma 25 R->L }
  f(X, f(f(f(W, V), y), f(f(V, X), f(y, X))))
= { by axiom 1 (hyp) R->L }
  y
% SZS output end Proof

RESULT: Theorem (the conjecture is true).
