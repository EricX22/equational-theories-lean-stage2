  f(x, f(f(f(y, X), f(f(x, y), f(X, X))), f(x, f(f(f(f(f(y, X), f(f(x, y), f(X, X))), Y), f(f(x, f(f(y, X), f(f(x, y), f(X, X)))), f(Y, Y))), f(f(f(f(y, X), f(f(x, y), f(X, X))), Y), f(f(x, f(f(y, X), f(f(x, y), f(X, X)))), f(Y, Y)))))))
= { by lemma 22 }
  f(x, f(f(f(y, X), f(f(x, y), f(X, X))), f(x, f(f(f(f(y, X), f(f(x, y), f(X, X))), Y), f(f(x, f(f(y, X), f(f(x, y), f(X, X)))), f(Y, Y))))))
= { by axiom 1 (hyp) R->L }
  f(x, f(f(f(y, X), f(f(x, y), f(X, X))), f(f(y, X), f(f(x, y), f(X, X)))))
= { by lemma 22 }
  f(x, f(f(y, X), f(f(x, y), f(X, X))))
= { by axiom 1 (hyp) R->L }
  y
% SZS output end Proof

RESULT: Theorem (the conjecture is true).
