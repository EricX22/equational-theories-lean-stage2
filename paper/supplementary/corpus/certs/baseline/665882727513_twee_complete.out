Lemma 10: f(f(X, Y), f(Z, f(f(f(X, Y), f(W, Z)), f(X, Y)))) = Z.
Proof:
  f(f(X, Y), f(Z, f(f(f(X, Y), f(W, Z)), f(X, Y))))
= { by lemma 8 R->L }
  f(f(X, Y), f(Z, f(f(f(X, Y), f(W, Z)), f(f(X, Y), f(f(Y, f(X, Y)), f(f(Y, f(V, f(Y, f(X, Y)))), f(Y, f(X, Y))))))))
= { by lemma 9 }
  Z

Lemma 11: f(f(X, Y), f(X, Y)) = f(X, Y).
Proof:
  f(f(X, Y), f(X, Y))
= { by lemma 10 R->L }
  f(f(f(X, Y), f(f(X, Y), f(f(f(X, Y), f(Z, f(X, Y))), f(X, Y)))), f(X, Y))
= { by lemma 6 R->L }
  f(f(f(X, Y), f(f(f(X, Y), f(f(f(X, Y), f(Z, f(X, Y))), f(X, Y))), f(X, Y))), f(X, Y))
= { by lemma 6 }
  f(f(X, Y), f(f(f(X, Y), f(f(f(X, Y), f(Z, f(X, Y))), f(X, Y))), f(X, Y)))
= { by lemma 6 }
  f(f(X, Y), f(f(X, Y), f(f(f(X, Y), f(Z, f(X, Y))), f(X, Y))))
= { by lemma 10 }
  f(X, Y)

Lemma 12: f(f(X, Y), f(Y, f(X, Y))) = Y.
