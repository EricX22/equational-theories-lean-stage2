Lemma 13: f(X, f(Y, X)) = X.
Proof:
  f(X, f(Y, X))
= { by lemma 12 R->L }
  f(f(f(Y, X), f(X, f(Y, X))), f(Y, X))
= { by lemma 6 }
  f(f(Y, X), f(X, f(Y, X)))
= { by lemma 12 }
  X

Goal 1 (goal): x = y.
Proof:
  x
= { by lemma 13 R->L }
  f(x, f(y, x))
= { by lemma 13 R->L }
  f(x, f(y, f(x, f(x, x))))
= { by lemma 13 R->L }
  f(x, f(y, f(x, f(x, f(x, f(X, x))))))
= { by lemma 13 R->L }
  f(x, f(y, f(x, f(f(x, f(Y, x)), f(x, f(X, x))))))
= { by lemma 13 R->L }
  f(x, f(y, f(x, f(f(x, f(Y, x)), f(x, f(X, f(x, f(Z, x))))))))
= { by lemma 13 R->L }
  f(x, f(y, f(x, f(f(x, f(Y, x)), f(f(x, f(Z, x)), f(X, f(x, f(Z, x))))))))
= { by lemma 13 R->L }
  f(x, f(y, f(x, f(f(f(x, f(Z, x)), f(Y, x)), f(f(x, f(Z, x)), f(X, f(x, f(Z, x))))))))
= { by lemma 13 R->L }
  f(f(x, f(Z, x)), f(y, f(x, f(f(f(x, f(Z, x)), f(Y, x)), f(f(x, f(Z, x)), f(X, f(x, f(Z, x))))))))
= { by lemma 5 }
  y
