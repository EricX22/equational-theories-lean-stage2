  f(f(f(X, f(f(f(X, X), X), Y)), f(Y, X)), f(f(f(Y, X), X), f(X, X)))
= { by lemma 25 R->L }
  f(f(f(X, f(f(f(X, X), X), Y)), f(Y, X)), f(f(f(Y, X), f(X, X)), f(X, X)))
= { by lemma 25 R->L }
  f(f(f(X, f(f(f(X, X), X), Y)), f(Y, X)), f(f(f(Y, X), f(X, X)), f(f(X, X), X)))
= { by lemma 18 R->L }
  f(f(f(X, f(f(f(f(X, X), f(X, X)), X), Y)), f(Y, X)), f(f(f(Y, X), f(X, X)), f(f(X, X), X)))
= { by lemma 18 R->L }
  f(f(f(X, f(f(f(f(X, X), f(X, X)), X), Y)), f(Y, X)), f(f(f(Y, X), f(X, X)), f(f(f(X, X), f(X, X)), X)))
= { by lemma 5 R->L }
  f(f(f(X, f(f(f(f(X, X), f(X, X)), X), Y)), f(Y, X)), f(f(f(Y, X), f(f(f(X, f(X, X)), f(X, X)), f(f(f(X, X), f(X, X)), X))), f(f(f(X, X), f(X, X)), X)))
= { by lemma 7 }
  f(f(f(X, f(X, X)), f(X, X)), f(f(f(X, X), f(X, X)), X))
= { by lemma 5 }
  f(X, X)
= { by lemma 25 }
  X

Goal 1 (goal): x = y.
Proof:
  x
= { by lemma 25 R->L }
  f(x, x)
= { by lemma 35 R->L }
  f(f(x, f(x, f(x, f(y, y)))), x)
= { by lemma 17 R->L }
  f(f(f(y, y), x), f(f(x, f(f(x, f(x, f(x, f(y, y)))), x)), x))
= { by lemma 35 }
  f(f(f(y, y), x), f(f(x, f(x, x)), x))
= { by lemma 24 }
  f(f(f(y, y), x), f(f(x, x), x))
= { by lemma 34 }
  f(f(f(y, y), x), x)
= { by lemma 34 }
  f(y, y)
= { by lemma 25 }
  y
% SZS output end Proof

RESULT: Theorem (the conjecture is true).
