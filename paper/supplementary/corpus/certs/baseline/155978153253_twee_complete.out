  f(f(f(Y, f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))))))), f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))))), f(Y, Y))
= { by lemma 15 }
  f(f(f(Y, f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))))))), f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))))), f(Y, Y))
= { by lemma 15 }
  f(f(f(Y, f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))))))), f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))))), f(Y, Y))
= { by lemma 15 }
  f(f(f(Y, f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))))))), f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))))), f(Y, Y))
= { by lemma 15 }
  f(f(f(Y, f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))))))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(Y, Y))
= { by lemma 15 }
  f(f(f(Y, f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(Y, Y))
= { by lemma 15 }
  f(f(f(Y, f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(Y, Y))
= { by lemma 15 }
  f(f(f(Y, f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(Y, Y))
= { by lemma 12 }
  f(f(f(Z, f(f(X, f(X, X)), f(X, f(X, X)))), f(f(X, f(X, X)), f(X, f(X, X)))), f(Z, Z))
= { by lemma 13 }
  f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))

Lemma 20: f(f(f(X, f(X, X)), f(X, f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))) = f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))).
Proof:
  f(f(f(X, f(X, X)), f(X, f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))))
= { by lemma 19 R->L }
  f(f(f(X, f(X, X)), f(X, f(X, X))), f(f(f(X, f(X, X)), f(X, f(X, X))), f(f(X, f(X, X)), f(X, f(X, X)))))
= { by lemma 14 R->L }
  f(f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(X, f(X, X)), f(X, f(X, X)))), f(f(f(X, f(X, X)), f(X, f(X, X))), f(f(X, f(X, X)), f(X, f(X, X)))))
= { by lemma 19 R->L }
  f(f(f(f(f(X, f(X, X)), f(X, f(X, X))), f(f(X, f(X, X)), f(X, f(X, X)))), f(f(X, f(X, X)), f(X, f(X, X)))), f(f(f(X, f(X, X)), f(X, f(X, X))), f(f(X, f(X, X)), f(X, f(X, X)))))
= { by lemma 13 }
  f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))

Lemma 21: f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))) = f(f(X, f(X, X)), f(X, f(X, X))).
Proof:
  f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))
= { by lemma 13 R->L }
  f(f(f(Y, f(f(X, f(X, X)), f(X, f(X, X)))), f(f(X, f(X, X)), f(X, f(X, X)))), f(Y, Y))
= { by lemma 12 R->L }
  f(f(f(Z, f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(Z, Z))
= { by lemma 20 R->L }
  f(f(f(Z, f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(f(f(X, f(X, X)), f(X, f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))))), f(Z, Z))
= { by lemma 20 R->L }
  f(f(f(Z, f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(f(f(X, f(X, X)), f(X, f(X, X))), f(f(f(X, f(X, X)), f(X, f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))))), f(Z, Z))
= { by axiom 1 (hyp) R->L }
  f(f(X, f(X, X)), f(X, f(X, X)))

Lemma 22: f(f(f(f(X, X), f(X, X)), f(f(X, f(X, X)), f(X, f(X, X)))), f(f(X, f(X, X)), f(X, f(X, X)))) = f(f(X, f(X, X)), f(X, f(X, X))).
Proof:
  f(f(f(f(X, X), f(X, X)), f(f(X, f(X, X)), f(X, f(X, X)))), f(f(X, f(X, X)), f(X, f(X, X))))
= { by lemma 21 R->L }
  f(f(f(f(X, X), f(X, X)), f(f(X, f(X, X)), f(X, f(X, X)))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))))
= { by lemma 19 R->L }
  f(f(f(f(X, X), f(X, X)), f(f(X, f(X, X)), f(X, f(X, X)))), f(f(f(X, f(X, X)), f(X, f(X, X))), f(f(X, f(X, X)), f(X, f(X, X)))))
= { by lemma 21 R->L }
  f(f(f(f(X, X), f(X, X)), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(f(f(X, f(X, X)), f(X, f(X, X))), f(f(X, f(X, X)), f(X, f(X, X)))))
= { by lemma 21 R->L }
  f(f(f(f(X, X), f(X, X)), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(X, f(X, X)), f(X, f(X, X)))))
= { by lemma 21 R->L }
  f(f(f(f(X, X), f(X, X)), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))))
= { by lemma 15 R->L }
  f(f(f(f(X, X), f(X, X)), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))))))
= { by lemma 3 R->L }
  f(f(f(Y, f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))), f(Y, Y))
= { by lemma 12 }
  f(f(f(Z, f(f(X, f(X, X)), f(X, f(X, X)))), f(f(X, f(X, X)), f(X, f(X, X)))), f(Z, Z))
= { by lemma 13 }
  f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))
= { by lemma 21 }
  f(f(X, f(X, X)), f(X, f(X, X)))

Lemma 23: f(f(f(X, X), f(X, X)), f(f(X, f(X, X)), f(X, f(X, X)))) = f(f(X, f(X, X)), f(X, f(X, X))).
Proof:
  f(f(f(X, X), f(X, X)), f(f(X, f(X, X)), f(X, f(X, X))))
= { by axiom 1 (hyp) }
  f(f(f(Y, f(f(X, f(X, X)), f(X, f(X, X)))), f(f(f(f(X, X), f(X, X)), f(f(X, f(X, X)), f(X, f(X, X)))), f(f(f(f(X, X), f(X, X)), f(f(X, f(X, X)), f(X, f(X, X)))), f(f(X, f(X, X)), f(X, f(X, X)))))), f(Y, Y))
= { by lemma 22 }
  f(f(f(Y, f(f(X, f(X, X)), f(X, f(X, X)))), f(f(f(f(X, X), f(X, X)), f(f(X, f(X, X)), f(X, f(X, X)))), f(f(X, f(X, X)), f(X, f(X, X))))), f(Y, Y))
= { by lemma 22 }
  f(f(f(Y, f(f(X, f(X, X)), f(X, f(X, X)))), f(f(X, f(X, X)), f(X, f(X, X)))), f(Y, Y))
= { by lemma 13 }
  f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))
= { by lemma 21 }
  f(f(X, f(X, X)), f(X, f(X, X)))

Lemma 24: f(f(X, f(X, X)), f(X, f(X, X))) = f(f(X, X), f(X, X)).
Proof:
  f(f(X, f(X, X)), f(X, f(X, X)))
= { by lemma 21 R->L }
  f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X)))
= { by lemma 13 R->L }
  f(f(f(Y, f(f(X, f(X, X)), f(X, f(X, X)))), f(f(X, f(X, X)), f(X, f(X, X)))), f(Y, Y))
= { by lemma 23 R->L }
  f(f(f(Y, f(f(X, f(X, X)), f(X, f(X, X)))), f(f(f(X, X), f(X, X)), f(f(X, f(X, X)), f(X, f(X, X))))), f(Y, Y))
= { by lemma 23 R->L }
  f(f(f(Y, f(f(X, f(X, X)), f(X, f(X, X)))), f(f(f(X, X), f(X, X)), f(f(f(X, X), f(X, X)), f(f(X, f(X, X)), f(X, f(X, X)))))), f(Y, Y))
= { by axiom 1 (hyp) R->L }
  f(f(X, X), f(X, X))

Lemma 25: f(f(f(X, f(f(Y, Y), f(Y, Y))), f(f(Y, Y), f(Y, Y))), f(X, X)) = f(f(Y, Y), f(Y, Y)).
Proof:
  f(f(f(X, f(f(Y, Y), f(Y, Y))), f(f(Y, Y), f(Y, Y))), f(X, X))
= { by lemma 24 R->L }
  f(f(f(X, f(f(Y, Y), f(Y, Y))), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), f(X, X))
= { by lemma 24 R->L }
  f(f(f(X, f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), f(X, X))
= { by lemma 13 }
  f(f(f(Y, Y), f(Y, Y)), f(f(Y, Y), f(Y, Y)))
= { by lemma 21 }
  f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))
= { by lemma 24 }
  f(f(Y, Y), f(Y, Y))

Lemma 26: f(f(f(X, X), f(f(X, X), f(X, X))), f(f(X, X), f(X, X))) = f(f(X, X), f(X, X)).
Proof:
  f(f(f(X, X), f(f(X, X), f(X, X))), f(f(X, X), f(X, X)))
= { by lemma 24 R->L }
  f(f(f(X, X), f(f(X, X), f(X, X))), f(f(X, f(X, X)), f(X, f(X, X))))
= { by lemma 21 R->L }
  f(f(f(X, X), f(f(X, X), f(X, X))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))))
= { by lemma 24 R->L }
  f(f(f(X, X), f(f(X, f(X, X)), f(X, f(X, X)))), f(f(f(X, X), f(X, X)), f(f(X, X), f(X, X))))
= { by lemma 24 R->L }
  f(f(f(X, X), f(f(X, f(X, X)), f(X, f(X, X)))), f(f(f(X, X), f(X, X)), f(f(X, f(X, X)), f(X, f(X, X)))))
= { by lemma 23 R->L }
  f(f(f(X, X), f(f(X, f(X, X)), f(X, f(X, X)))), f(f(f(X, X), f(X, X)), f(f(f(X, X), f(X, X)), f(f(X, f(X, X)), f(X, f(X, X))))))
= { by lemma 3 R->L }
  f(f(f(Y, f(f(X, X), f(X, X))), f(f(X, X), f(X, X))), f(Y, Y))
= { by lemma 25 }
  f(f(X, X), f(X, X))

Lemma 27: f(f(X, X), f(f(X, X), f(X, X))) = f(f(X, X), f(X, X)).
Proof:
  f(f(X, X), f(f(X, X), f(X, X)))
= { by axiom 1 (hyp) }
  f(f(f(Y, f(f(X, X), f(X, X))), f(f(f(X, X), f(f(X, X), f(X, X))), f(f(f(X, X), f(f(X, X), f(X, X))), f(f(X, X), f(X, X))))), f(Y, Y))
= { by lemma 26 }
  f(f(f(Y, f(f(X, X), f(X, X))), f(f(f(X, X), f(f(X, X), f(X, X))), f(f(X, X), f(X, X)))), f(Y, Y))
= { by lemma 26 }
  f(f(f(Y, f(f(X, X), f(X, X))), f(f(X, X), f(X, X))), f(Y, Y))
= { by lemma 25 }
  f(f(X, X), f(X, X))

Lemma 28: f(f(X, X), f(X, X)) = f(X, X).
Proof:
  f(f(X, X), f(X, X))
= { by lemma 25 R->L }
  f(f(f(Y, f(f(X, X), f(X, X))), f(f(X, X), f(X, X))), f(Y, Y))
= { by lemma 27 R->L }
  f(f(f(Y, f(f(X, X), f(X, X))), f(f(X, X), f(f(X, X), f(X, X)))), f(Y, Y))
= { by lemma 27 R->L }
  f(f(f(Y, f(f(X, X), f(X, X))), f(f(X, X), f(f(X, X), f(f(X, X), f(X, X))))), f(Y, Y))
= { by axiom 1 (hyp) R->L }
  f(X, X)

Lemma 29: f(f(f(X, f(Y, Y)), f(Y, Y)), f(X, X)) = f(Y, Y).
Proof:
  f(f(f(X, f(Y, Y)), f(Y, Y)), f(X, X))
= { by lemma 28 R->L }
  f(f(f(X, f(Y, Y)), f(f(Y, Y), f(Y, Y))), f(X, X))
= { by lemma 28 R->L }
  f(f(f(X, f(Y, Y)), f(f(Y, Y), f(f(Y, Y), f(Y, Y)))), f(X, X))
= { by axiom 1 (hyp) R->L }
  f(Y, Y)

Lemma 30: f(f(X, f(X, X)), f(X, X)) = f(X, X).
Proof:
  f(f(X, f(X, X)), f(X, X))
= { by axiom 1 (hyp) }
  f(f(f(Y, f(X, X)), f(f(f(X, f(X, X)), f(X, X)), f(f(f(X, f(X, X)), f(X, X)), f(X, X)))), f(Y, Y))
= { by lemma 29 }
  f(f(f(Y, f(X, X)), f(f(f(X, f(X, X)), f(X, X)), f(X, X))), f(Y, Y))
= { by lemma 29 }
  f(f(f(Y, f(X, X)), f(X, X)), f(Y, Y))
= { by lemma 29 }
  f(X, X)

Lemma 31: f(X, f(X, X)) = f(X, X).
Proof:
  f(X, f(X, X))
= { by axiom 1 (hyp) }
  f(f(f(Y, f(X, X)), f(f(X, f(X, X)), f(f(X, f(X, X)), f(X, X)))), f(Y, Y))
= { by lemma 30 }
  f(f(f(Y, f(X, X)), f(f(X, f(X, X)), f(X, X))), f(Y, Y))
= { by lemma 30 }
  f(f(f(Y, f(X, X)), f(X, X)), f(Y, Y))
= { by lemma 29 }
  f(X, X)

Lemma 32: f(X, X) = X.
Proof:
  f(X, X)
= { by lemma 29 R->L }
  f(f(f(Y, f(X, X)), f(X, X)), f(Y, Y))
= { by lemma 31 R->L }
  f(f(f(Y, f(X, X)), f(X, f(X, X))), f(Y, Y))
= { by lemma 31 R->L }
  f(f(f(Y, f(X, X)), f(X, f(X, f(X, X)))), f(Y, Y))
= { by axiom 1 (hyp) R->L }
  X

Lemma 33: f(f(f(X, Y), f(Z, f(Z, Y))), X) = Z.
Proof:
  f(f(f(X, Y), f(Z, f(Z, Y))), X)
= { by lemma 32 R->L }
  f(f(f(f(X, X), Y), f(Z, f(Z, Y))), X)
= { by lemma 32 R->L }
  f(f(f(f(X, X), Y), f(Z, f(Z, Y))), f(X, X))
= { by lemma 28 R->L }
  f(f(f(f(X, X), Y), f(Z, f(Z, Y))), f(f(X, X), f(X, X)))
= { by axiom 1 (hyp) R->L }
  Z

Lemma 34: f(f(X, f(f(f(X, Y), f(Z, f(Z, Y))), Z)), X) = f(f(X, Y), f(Z, f(Z, Y))).
Proof:
  f(f(X, f(f(f(X, Y), f(Z, f(Z, Y))), Z)), X)
= { by lemma 32 R->L }
  f(f(f(X, X), f(f(f(X, Y), f(Z, f(Z, Y))), Z)), X)
= { by lemma 32 R->L }
  f(f(f(X, X), f(f(f(f(X, X), Y), f(Z, f(Z, Y))), Z)), X)
= { by lemma 31 R->L }
  f(f(f(X, f(X, X)), f(f(f(f(X, X), Y), f(Z, f(Z, Y))), Z)), X)
= { by lemma 28 R->L }
  f(f(f(X, f(f(X, X), f(X, X))), f(f(f(f(X, X), Y), f(Z, f(Z, Y))), Z)), X)
= { by lemma 28 R->L }
  f(f(f(X, f(f(X, X), f(X, X))), f(f(f(f(f(X, X), f(X, X)), Y), f(Z, f(Z, Y))), Z)), X)
= { by lemma 24 R->L }
  f(f(f(X, f(f(X, f(X, X)), f(X, f(X, X)))), f(f(f(f(f(X, X), f(X, X)), Y), f(Z, f(Z, Y))), Z)), X)
= { by lemma 24 R->L }
  f(f(f(X, f(f(X, f(X, X)), f(X, f(X, X)))), f(f(f(f(f(X, f(X, X)), f(X, f(X, X))), Y), f(Z, f(Z, Y))), Z)), X)
= { by lemma 33 R->L }
  f(f(f(X, f(f(X, f(X, X)), f(X, f(X, X)))), f(f(f(f(f(X, f(X, X)), f(X, f(X, X))), Y), f(Z, f(Z, Y))), f(f(f(f(f(X, f(X, X)), f(X, f(X, X))), Y), f(Z, f(Z, Y))), f(f(X, f(X, X)), f(X, f(X, X)))))), X)
= { by lemma 33 }
  f(f(f(f(X, f(X, X)), f(X, f(X, X))), Y), f(Z, f(Z, Y)))
= { by lemma 24 }
  f(f(f(f(X, X), f(X, X)), Y), f(Z, f(Z, Y)))
= { by lemma 28 }
  f(f(f(X, X), Y), f(Z, f(Z, Y)))
= { by lemma 32 }
  f(f(X, Y), f(Z, f(Z, Y)))

Lemma 35: f(f(X, Y), f(f(X, X), f(f(X, X), Y))) = f(f(f(Z, f(X, X)), f(X, X)), Z).
Proof:
  f(f(X, Y), f(f(X, X), f(f(X, X), Y)))
= { by lemma 3 R->L }
  f(f(f(Z, f(X, X)), f(X, X)), f(Z, Z))
= { by lemma 32 }
  f(f(f(Z, f(X, X)), f(X, X)), Z)

Lemma 36: f(f(X, f(Y, Y)), f(f(f(Y, Z), f(X, f(X, Z))), f(f(Y, Z), f(X, f(X, Z))))) = f(f(f(W, f(Y, Y)), f(Y, Y)), f(W, W)).
Proof:
  f(f(X, f(Y, Y)), f(f(f(Y, Z), f(X, f(X, Z))), f(f(Y, Z), f(X, f(X, Z)))))
= { by axiom 1 (hyp) }
  f(f(f(f(f(Y, Z), f(X, f(X, Z))), f(Y, Y)), f(Y, Y)), f(f(f(Y, Z), f(X, f(X, Z))), f(f(Y, Z), f(X, f(X, Z)))))
= { by lemma 3 }
  f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V)))
= { by lemma 3 R->L }
  f(f(f(W, f(Y, Y)), f(Y, Y)), f(W, W))

Lemma 37: f(f(f(X, Y), Y), f(X, X)) = Y.
Proof:
  f(f(f(X, Y), Y), f(X, X))
= { by lemma 32 R->L }
  f(f(f(X, f(Y, Y)), Y), f(X, X))
= { by lemma 31 R->L }
  f(f(f(X, f(Y, f(Y, Y))), Y), f(X, X))
= { by lemma 31 R->L }
  f(f(f(X, f(Y, f(Y, f(Y, Y)))), Y), f(X, X))
= { by lemma 32 R->L }
  f(f(f(X, f(Y, f(f(Y, Y), f(Y, Y)))), Y), f(X, X))
= { by lemma 32 R->L }
  f(f(f(X, f(Y, f(f(Y, Y), f(f(Y, Y), Y)))), Y), f(X, X))
= { by lemma 32 R->L }
  f(f(f(X, f(Y, f(f(Y, Y), f(f(Y, Y), Y)))), f(Y, Y)), f(X, X))
= { by lemma 32 R->L }
  f(f(f(X, f(f(Y, Y), f(f(Y, Y), f(f(Y, Y), Y)))), f(Y, Y)), f(X, X))
= { by lemma 32 R->L }
  f(f(f(X, f(f(Y, Y), f(f(f(Y, Y), Y), f(f(Y, Y), Y)))), f(Y, Y)), f(X, X))
= { by lemma 32 R->L }
  f(f(f(X, f(f(Y, Y), f(f(f(Y, Y), f(Y, Y)), f(f(Y, Y), Y)))), f(Y, Y)), f(X, X))
= { by lemma 32 R->L }
  f(f(f(X, f(f(Y, Y), f(f(f(Y, Y), f(Y, Y)), f(f(f(Y, Y), Y), Y)))), f(Y, Y)), f(X, X))
= { by lemma 32 R->L }
  f(f(f(X, f(f(Y, Y), f(f(f(Y, Y), f(Y, Y)), f(f(f(Y, Y), f(Y, Y)), Y)))), f(Y, Y)), f(X, X))
= { by lemma 32 R->L }
  f(f(f(X, f(f(Y, Y), f(f(f(Y, Y), f(Y, Y)), f(f(f(Y, Y), f(Y, Y)), f(Y, Y))))), f(Y, Y)), f(X, X))
= { by lemma 32 R->L }
  f(f(f(X, f(f(Y, Y), f(f(f(Y, Y), f(Y, Y)), f(f(f(Y, Y), f(Y, Y)), f(Y, Y))))), f(f(Y, Y), Y)), f(X, X))
= { by lemma 32 R->L }
  f(f(f(X, f(f(Y, Y), f(f(f(Y, Y), f(Y, Y)), f(f(f(Y, Y), f(Y, Y)), f(Y, Y))))), f(f(Y, Y), f(Y, Y))), f(X, X))
= { by lemma 28 R->L }
  f(f(f(X, f(f(f(Y, Y), f(Y, Y)), f(f(f(Y, Y), f(Y, Y)), f(f(f(Y, Y), f(Y, Y)), f(Y, Y))))), f(f(Y, Y), f(Y, Y))), f(X, X))
= { by lemma 28 R->L }
  f(f(f(X, f(f(f(Y, Y), f(Y, Y)), f(f(f(Y, Y), f(f(Y, Y), f(Y, Y))), f(f(f(Y, Y), f(Y, Y)), f(Y, Y))))), f(f(Y, Y), f(Y, Y))), f(X, X))
= { by lemma 28 R->L }
  f(f(f(X, f(f(f(Y, Y), f(Y, Y)), f(f(f(Y, Y), f(f(Y, Y), f(Y, Y))), f(f(f(Y, Y), f(f(Y, Y), f(Y, Y))), f(Y, Y))))), f(f(Y, Y), f(Y, Y))), f(X, X))
= { by lemma 28 R->L }
  f(f(f(X, f(f(f(Y, Y), f(Y, Y)), f(f(f(Y, Y), f(f(Y, Y), f(Y, Y))), f(f(f(Y, Y), f(f(Y, Y), f(Y, Y))), f(f(Y, Y), f(Y, Y)))))), f(f(Y, Y), f(Y, Y))), f(X, X))
= { by lemma 28 R->L }
  f(f(f(X, f(f(f(Y, Y), f(Y, Y)), f(f(f(Y, Y), f(f(Y, Y), f(Y, Y))), f(f(f(Y, Y), f(f(Y, Y), f(Y, Y))), f(f(Y, Y), f(Y, Y)))))), f(f(Y, Y), f(f(Y, Y), f(Y, Y)))), f(X, X))
= { by lemma 28 R->L }
  f(f(f(X, f(f(f(Y, Y), f(f(Y, Y), f(Y, Y))), f(f(f(Y, Y), f(f(Y, Y), f(Y, Y))), f(f(f(Y, Y), f(f(Y, Y), f(Y, Y))), f(f(Y, Y), f(Y, Y)))))), f(f(Y, Y), f(f(Y, Y), f(Y, Y)))), f(X, X))
= { by lemma 18 }
  f(f(f(Y, Y), f(f(Y, Y), f(Y, Y))), f(f(f(Y, Y), f(f(Y, Y), f(Y, Y))), f(f(f(Y, Y), f(f(Y, Y), f(Y, Y))), f(f(Y, Y), f(Y, Y)))))
= { by lemma 27 }
  f(f(f(Y, Y), f(Y, Y)), f(f(f(Y, Y), f(f(Y, Y), f(Y, Y))), f(f(f(Y, Y), f(f(Y, Y), f(Y, Y))), f(f(Y, Y), f(Y, Y)))))
= { by lemma 27 }
  f(f(f(Y, Y), f(Y, Y)), f(f(f(Y, Y), f(Y, Y)), f(f(f(Y, Y), f(f(Y, Y), f(Y, Y))), f(f(Y, Y), f(Y, Y)))))
= { by lemma 27 }
  f(f(f(Y, Y), f(Y, Y)), f(f(f(Y, Y), f(Y, Y)), f(f(f(Y, Y), f(Y, Y)), f(f(Y, Y), f(Y, Y)))))
= { by lemma 28 }
  f(f(Y, Y), f(f(f(Y, Y), f(Y, Y)), f(f(f(Y, Y), f(Y, Y)), f(f(Y, Y), f(Y, Y)))))
= { by lemma 28 }
  f(f(Y, Y), f(f(Y, Y), f(f(f(Y, Y), f(Y, Y)), f(f(Y, Y), f(Y, Y)))))
= { by lemma 28 }
  f(f(Y, Y), f(f(Y, Y), f(f(Y, Y), f(f(Y, Y), f(Y, Y)))))
= { by lemma 28 }
  f(f(Y, Y), f(f(Y, Y), f(f(Y, Y), f(Y, Y))))
= { by lemma 32 }
  f(Y, f(f(Y, Y), f(f(Y, Y), f(Y, Y))))
= { by lemma 32 }
  f(Y, f(Y, f(f(Y, Y), f(Y, Y))))
= { by lemma 32 }
  f(Y, f(Y, f(Y, f(Y, Y))))
= { by lemma 32 }
  f(Y, f(Y, f(Y, Y)))
= { by lemma 31 }
  f(Y, f(Y, Y))
= { by lemma 31 }
  f(Y, Y)
= { by lemma 32 }
  Y

Lemma 38: f(f(X, f(Y, X)), f(Y, Y)) = Y.
Proof:
  f(f(X, f(Y, X)), f(Y, Y))
= { by lemma 33 R->L }
  f(f(X, f(Y, X)), f(f(f(f(X, Z), f(Y, f(Y, Z))), X), Y))
= { by lemma 33 R->L }
  f(f(X, f(Y, X)), f(f(f(f(X, Z), f(Y, f(Y, Z))), X), f(f(f(X, Z), f(Y, f(Y, Z))), X)))
= { by lemma 34 R->L }
  f(f(X, f(Y, X)), f(f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X), f(f(f(X, Z), f(Y, f(Y, Z))), X)))
= { by lemma 34 R->L }
  f(f(X, f(Y, X)), f(f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X), f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X)))
= { by lemma 32 R->L }
  f(f(X, f(Y, f(X, X))), f(f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X), f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X)))
= { by lemma 32 R->L }
  f(f(X, f(Y, f(f(X, X), X))), f(f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X), f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X)))
= { by lemma 30 R->L }
  f(f(X, f(Y, f(f(f(X, f(X, X)), f(X, X)), X))), f(f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X), f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X)))
= { by lemma 35 R->L }
  f(f(X, f(Y, f(f(X, W), f(f(X, X), f(f(X, X), W))))), f(f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X), f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X)))
= { by lemma 3 R->L }
  f(f(X, f(Y, f(f(f(V, f(X, X)), f(X, X)), f(V, V)))), f(f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X), f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X)))
= { by lemma 36 R->L }
  f(f(X, f(Y, f(f(f(f(X, Z), f(Y, f(Y, Z))), f(X, X)), f(f(f(X, X), f(f(f(X, Z), f(Y, f(Y, Z))), f(f(f(X, Z), f(Y, f(Y, Z))), X))), f(f(X, X), f(f(f(X, Z), f(Y, f(Y, Z))), f(f(f(X, Z), f(Y, f(Y, Z))), X))))))), f(f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X), f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X)))
= { by axiom 1 (hyp) R->L }
  f(f(X, f(Y, f(Y, f(f(f(X, X), f(f(f(X, Z), f(Y, f(Y, Z))), f(f(f(X, Z), f(Y, f(Y, Z))), X))), f(f(X, X), f(f(f(X, Z), f(Y, f(Y, Z))), f(f(f(X, Z), f(Y, f(Y, Z))), X))))))), f(f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X), f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X)))
= { by lemma 33 }
  f(f(X, f(Y, f(Y, f(f(f(X, X), f(f(f(X, Z), f(Y, f(Y, Z))), Y)), f(f(X, X), f(f(f(X, Z), f(Y, f(Y, Z))), f(f(f(X, Z), f(Y, f(Y, Z))), X))))))), f(f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X), f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X)))
= { by lemma 32 }
  f(f(X, f(Y, f(Y, f(f(f(X, X), f(f(f(X, Z), f(Y, f(Y, Z))), Y)), f(X, f(f(f(X, Z), f(Y, f(Y, Z))), f(f(f(X, Z), f(Y, f(Y, Z))), X))))))), f(f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X), f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X)))
= { by lemma 32 }
  f(f(X, f(Y, f(Y, f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), f(X, f(f(f(X, Z), f(Y, f(Y, Z))), f(f(f(X, Z), f(Y, f(Y, Z))), X))))))), f(f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X), f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X)))
= { by lemma 33 }
  f(f(X, f(Y, f(Y, f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)))))), f(f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X), f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X)))
= { by lemma 37 R->L }
  f(f(f(f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X), f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)))), f(Y, f(Y, f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)))))), f(f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X), f(f(f(X, f(f(f(X, Z), f(Y, f(Y, Z))), Y)), X), X)))
= { by axiom 1 (hyp) R->L }
  Y

Lemma 39: f(f(X, f(Y, f(Y, X))), X) = Y.
Proof:
  f(f(X, f(Y, f(Y, X))), X)
= { by lemma 32 R->L }
  f(f(X, f(Y, f(Y, X))), f(X, X))
= { by lemma 32 R->L }
  f(f(f(X, X), f(Y, f(Y, X))), f(X, X))
= { by lemma 32 R->L }
  f(f(f(X, X), f(Y, f(Y, f(X, X)))), f(X, X))
= { by lemma 32 R->L }
  f(f(f(X, X), f(Y, f(Y, f(X, X)))), f(f(X, X), X))
= { by lemma 32 R->L }
  f(f(f(X, X), f(Y, f(Y, f(X, X)))), f(f(X, X), f(X, X)))
= { by lemma 28 R->L }
  f(f(f(f(X, X), f(X, X)), f(Y, f(Y, f(X, X)))), f(f(X, X), f(X, X)))
= { by axiom 1 (hyp) R->L }
  Y

Lemma 40: f(X, f(f(f(Y, Z), f(f(f(Y, X), X), f(f(f(Y, X), X), Z))), f(f(Y, Z), f(f(f(Y, X), X), f(f(f(Y, X), X), Z))))) = f(f(f(W, f(Y, Y)), f(Y, Y)), W).
Proof:
  f(X, f(f(f(Y, Z), f(f(f(Y, X), X), f(f(f(Y, X), X), Z))), f(f(Y, Z), f(f(f(Y, X), X), f(f(f(Y, X), X), Z)))))
= { by lemma 37 R->L }
  f(f(f(f(Y, X), X), f(Y, Y)), f(f(f(Y, Z), f(f(f(Y, X), X), f(f(f(Y, X), X), Z))), f(f(Y, Z), f(f(f(Y, X), X), f(f(f(Y, X), X), Z)))))
= { by axiom 1 (hyp) }
  f(f(f(f(f(Y, Z), f(f(f(Y, X), X), f(f(f(Y, X), X), Z))), f(Y, Y)), f(Y, Y)), f(f(f(Y, Z), f(f(f(Y, X), X), f(f(f(Y, X), X), Z))), f(f(Y, Z), f(f(f(Y, X), X), f(f(f(Y, X), X), Z)))))
= { by lemma 6 }
  f(f(f(f(f(Y, V), f(U, f(U, V))), f(Y, Y)), f(Y, Y)), f(f(f(Y, V), f(U, f(U, V))), f(f(Y, V), f(U, f(U, V)))))
= { by axiom 1 (hyp) R->L }
  f(f(U, f(Y, Y)), f(f(f(Y, V), f(U, f(U, V))), f(f(Y, V), f(U, f(U, V)))))
= { by lemma 36 }
  f(f(f(W, f(Y, Y)), f(Y, Y)), f(W, W))
= { by lemma 32 }
  f(f(f(W, f(Y, Y)), f(Y, Y)), W)

Lemma 41: f(f(f(f(X, f(Y, Y)), f(Y, Y)), X), f(Y, Y)) = f(Y, Y).
Proof:
  f(f(f(f(X, f(Y, Y)), f(Y, Y)), X), f(Y, Y))
= { by lemma 32 R->L }
  f(f(f(f(X, f(Y, Y)), f(Y, Y)), f(X, X)), f(Y, Y))
= { by lemma 4 }
  f(Y, Y)

Lemma 42: f(X, f(f(Y, X), f(f(Y, X), X))) = Y.
Proof:
  f(X, f(f(Y, X), f(f(Y, X), X)))
= { by lemma 38 R->L }
  f(f(X, f(f(X, f(f(Y, X), f(f(Y, X), X))), X)), f(f(X, f(f(Y, X), f(f(Y, X), X))), f(X, f(f(Y, X), f(f(Y, X), X)))))
