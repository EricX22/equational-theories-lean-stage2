= { by lemma 35 }
  f(f(f(f(T, f(f(f(f(S, f(Y, Y)), f(Y, Y)), S), f(f(f(S, f(Y, Y)), f(Y, Y)), S))), f(f(f(f(S, f(Y, Y)), f(Y, Y)), S), f(f(Y, U), f(f(Y, Y), f(f(Y, Y), U))))), f(T, T)), f(f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V))), f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V)))))
= { by lemma 35 }
  f(f(f(f(T, f(f(f(f(S, f(Y, Y)), f(Y, Y)), S), f(f(f(S, f(Y, Y)), f(Y, Y)), S))), f(f(f(f(S, f(Y, Y)), f(Y, Y)), S), f(f(f(S, f(Y, Y)), f(Y, Y)), S))), f(T, T)), f(f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V))), f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V)))))
= { by lemma 32 }
  f(f(f(f(T, f(f(f(f(S, f(Y, Y)), f(Y, Y)), S), f(f(f(S, f(Y, Y)), f(Y, Y)), S))), f(f(f(f(S, f(Y, Y)), f(Y, Y)), S), f(f(f(S, f(Y, Y)), f(Y, Y)), S))), T), f(f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V))), f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V)))))
= { by lemma 44 R->L }
  f(f(f(f(f(f(X2, f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), X2), f(f(f(f(S, f(Y, Y)), f(Y, Y)), S), f(f(f(S, f(Y, Y)), f(Y, Y)), S))), f(f(f(f(f(f(S, f(Y, Y)), f(Y, Y)), S), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), f(f(f(f(f(S, f(Y, Y)), f(Y, Y)), S), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))))), f(f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V))), f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V)))))
= { by lemma 46 }
  f(f(f(f(f(Y2, f(Y, Y)), f(Y, Y)), Y2), f(f(f(f(f(f(S, f(Y, Y)), f(Y, Y)), S), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), f(f(f(f(f(S, f(Y, Y)), f(Y, Y)), S), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))))), f(f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V))), f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V)))))
= { by lemma 47 }
  f(f(f(f(f(Y2, f(Y, Y)), f(Y, Y)), Y2), f(f(f(f(f(Z2, f(Y, Y)), f(Y, Y)), Z2), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), f(f(f(f(f(S, f(Y, Y)), f(Y, Y)), S), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))))), f(f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V))), f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V)))))
= { by lemma 47 }
  f(f(f(f(f(Y2, f(Y, Y)), f(Y, Y)), Y2), f(f(f(f(f(Z2, f(Y, Y)), f(Y, Y)), Z2), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), f(f(f(f(W2, f(Y, Y)), f(Y, Y)), W2), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))))), f(f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V))), f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V)))))
= { by lemma 47 }
  f(f(f(f(f(Y2, f(Y, Y)), f(Y, Y)), Y2), f(f(f(f(V2, f(Y, Y)), f(Y, Y)), V2), f(f(f(f(W2, f(Y, Y)), f(Y, Y)), W2), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))))), f(f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V))), f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V)))))
= { by lemma 47 }
  f(f(f(f(f(Y2, f(Y, Y)), f(Y, Y)), Y2), f(f(f(f(V2, f(Y, Y)), f(Y, Y)), V2), f(f(f(U2, f(Y, Y)), f(Y, Y)), U2))), f(f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V))), f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V)))))
= { by lemma 45 }
  f(f(f(f(T2, f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), T2), f(f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V))), f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V)))))
= { by lemma 35 }
  f(f(f(f(T2, f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), T2), f(f(f(f(S2, f(Y, Y)), f(Y, Y)), S2), f(f(Y, V), f(f(Y, Y), f(f(Y, Y), V)))))
= { by lemma 35 }
  f(f(f(f(T2, f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), T2), f(f(f(f(S2, f(Y, Y)), f(Y, Y)), S2), f(f(f(X3, f(Y, Y)), f(Y, Y)), X3)))
= { by lemma 46 }
  f(f(f(W, f(Y, Y)), f(Y, Y)), W)

Lemma 49: f(f(X, f(f(X, X), X)), f(f(X, Y), f(f(X, X), f(f(X, X), Y)))) = f(f(X, Z), f(f(X, X), f(f(X, X), Z))).
Proof:
  f(f(X, f(f(X, X), X)), f(f(X, Y), f(f(X, X), f(f(X, X), Y))))
= { by lemma 16 }
  f(f(X, f(f(X, X), X)), f(f(X, X), f(f(X, X), f(f(X, X), X))))
= { by lemma 16 R->L }
  f(f(X, Z), f(f(X, X), f(f(X, X), Z)))

Lemma 50: f(f(f(X, f(Y, Y)), f(Y, Y)), X) = f(Y, f(f(Y, Y), Y)).
Proof:
  f(f(f(X, f(Y, Y)), f(Y, Y)), X)
= { by axiom 1 (hyp) }
  f(f(f(Z, f(f(f(W, f(Y, Y)), f(Y, Y)), W)), f(f(f(f(X, f(Y, Y)), f(Y, Y)), X), f(f(f(f(X, f(Y, Y)), f(Y, Y)), X), f(f(f(W, f(Y, Y)), f(Y, Y)), W)))), f(Z, Z))
= { by lemma 48 }
  f(f(f(Z, f(f(f(W, f(Y, Y)), f(Y, Y)), W)), f(f(f(f(X, f(Y, Y)), f(Y, Y)), X), f(f(f(V, f(Y, Y)), f(Y, Y)), V))), f(Z, Z))
= { by lemma 48 }
  f(f(f(Z, f(f(f(W, f(Y, Y)), f(Y, Y)), W)), f(f(f(U, f(Y, Y)), f(Y, Y)), U)), f(Z, Z))
= { by lemma 35 R->L }
  f(f(f(Z, f(f(f(W, f(Y, Y)), f(Y, Y)), W)), f(f(Y, T), f(f(Y, Y), f(f(Y, Y), T)))), f(Z, Z))
= { by lemma 35 R->L }
  f(f(f(Z, f(f(Y, S), f(f(Y, Y), f(f(Y, Y), S)))), f(f(Y, T), f(f(Y, Y), f(f(Y, Y), T)))), f(Z, Z))
= { by lemma 49 R->L }
  f(f(f(Z, f(f(Y, S), f(f(Y, Y), f(f(Y, Y), S)))), f(f(Y, f(f(Y, Y), Y)), f(f(Y, X2), f(f(Y, Y), f(f(Y, Y), X2))))), f(Z, Z))
= { by lemma 49 R->L }
  f(f(f(Z, f(f(Y, S), f(f(Y, Y), f(f(Y, Y), S)))), f(f(Y, f(f(Y, Y), Y)), f(f(Y, f(f(Y, Y), Y)), f(f(Y, S), f(f(Y, Y), f(f(Y, Y), S)))))), f(Z, Z))
= { by axiom 1 (hyp) R->L }
  f(Y, f(f(Y, Y), Y))

Lemma 51: f(X, Y) = X.
Proof:
  f(X, Y)
= { by lemma 32 R->L }
  f(X, f(Y, Y))
= { by lemma 32 R->L }
  f(f(X, X), f(Y, Y))
= { by lemma 43 R->L }
  f(f(X, f(f(X, X), X)), f(Y, Y))
= { by lemma 50 R->L }
  f(f(f(f(Z, f(X, X)), f(X, X)), Z), f(Y, Y))
= { by lemma 43 R->L }
  f(f(f(f(Y, f(X, X)), f(X, X)), f(f(Y, f(X, X)), f(X, X))), f(f(f(f(f(Z, f(X, X)), f(X, X)), Z), f(Y, Y)), f(f(f(Y, f(X, X)), f(X, X)), f(f(Y, f(X, X)), f(X, X)))))
= { by lemma 44 }
  f(f(f(f(Y, f(X, X)), f(X, X)), f(f(Y, f(X, X)), f(X, X))), f(f(f(W, f(Y, Y)), f(Y, Y)), W))
= { by lemma 32 }
  f(f(f(Y, f(X, X)), f(X, X)), f(f(f(W, f(Y, Y)), f(Y, Y)), W))
= { by lemma 32 }
  f(f(f(Y, X), f(X, X)), f(f(f(W, f(Y, Y)), f(Y, Y)), W))
= { by lemma 32 }
  f(f(f(Y, X), X), f(f(f(W, f(Y, Y)), f(Y, Y)), W))
= { by lemma 50 }
  f(f(f(Y, X), X), f(Y, f(f(Y, Y), Y)))
= { by lemma 43 }
  f(f(f(Y, X), X), f(Y, Y))
= { by lemma 32 R->L }
  f(f(f(Y, X), f(X, X)), f(Y, Y))
= { by lemma 32 R->L }
  f(f(f(Y, X), f(X, f(X, X))), f(Y, Y))
= { by axiom 1 (hyp) R->L }
  X

Goal 1 (goal): x = y.
Proof:
  x
= { by axiom 1 (hyp) }
  f(f(f(X, Y), f(x, f(x, Y))), f(X, X))
= { by lemma 51 }
  f(f(X, Y), f(x, f(x, Y)))
= { by lemma 51 }
  f(X, Y)
= { by lemma 51 R->L }
  f(f(X, Y), f(y, f(y, Y)))
= { by lemma 51 R->L }
  f(f(f(X, Y), f(y, f(y, Y))), f(X, X))
= { by axiom 1 (hyp) R->L }
  y
% SZS output end Proof

