  f(f(X, f(f(X, f(f(Y, X), f(f(Y, X), X))), X)), f(f(f(Y, X), f(f(f(X, f(f(Y, X), f(f(Y, X), X))), f(X, f(f(Y, X), f(f(Y, X), X)))), f(f(f(X, f(f(Y, X), f(f(Y, X), X))), f(X, f(f(Y, X), f(f(Y, X), X)))), X))), f(Y, Y)))
= { by lemma 39 R->L }
  f(f(X, f(f(X, f(f(Y, X), f(f(Y, X), X))), X)), f(f(f(f(X, f(f(Y, X), f(f(Y, X), X))), X), f(f(f(X, f(f(Y, X), f(f(Y, X), X))), f(X, f(f(Y, X), f(f(Y, X), X)))), f(f(f(X, f(f(Y, X), f(f(Y, X), X))), f(X, f(f(Y, X), f(f(Y, X), X)))), X))), f(Y, Y)))
= { by lemma 3 R->L }
  f(f(X, f(f(X, f(f(Y, X), f(f(Y, X), X))), X)), f(f(f(f(Z, f(f(X, f(f(Y, X), f(f(Y, X), X))), f(X, f(f(Y, X), f(f(Y, X), X))))), f(f(X, f(f(Y, X), f(f(Y, X), X))), f(X, f(f(Y, X), f(f(Y, X), X))))), f(Z, Z)), f(Y, Y)))
= { by lemma 32 }
  f(f(X, f(f(X, f(f(Y, X), f(f(Y, X), X))), X)), f(f(f(f(Z, f(f(X, f(f(Y, X), f(f(Y, X), X))), f(X, f(f(Y, X), f(f(Y, X), X))))), f(f(X, f(f(Y, X), f(f(Y, X), X))), f(X, f(f(Y, X), f(f(Y, X), X))))), Z), f(Y, Y)))
= { by lemma 32 R->L }
  f(f(X, f(f(X, f(f(Y, X), f(f(Y, X), X))), X)), f(f(f(f(Z, f(f(X, f(f(Y, X), f(f(Y, X), f(X, X)))), f(X, f(f(Y, X), f(f(Y, X), X))))), f(f(X, f(f(Y, X), f(f(Y, X), X))), f(X, f(f(Y, X), f(f(Y, X), X))))), Z), f(Y, Y)))
= { by lemma 32 R->L }
