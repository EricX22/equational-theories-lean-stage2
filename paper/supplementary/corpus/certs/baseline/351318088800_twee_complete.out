= { by lemma 7 R->L }
  f(f(f(Y, X), f(X, f(f(X, f(X, X)), f(X, f(X, X))))), f(f(X, f(X, X)), f(f(X, X), f(X, f(f(X, f(X, f(X, X))), f(f(Y, X), f(X, f(f(X, f(X, X)), f(X, f(X, X))))))))))
