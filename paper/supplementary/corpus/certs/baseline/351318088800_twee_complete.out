  f(f(Y, f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), f(f(f(Z, f(X, Y)), f(X, Y)), f(f(X, Y), f(f(f(Y, Y), f(Y, f(Y, Y))), f(f(Y, Y), f(Y, f(Y, Y)))))))
= { by lemma 22 }
  f(f(Y, f(f(Y, f(Y, Y)), f(Y, f(Y, Y)))), f(f(X, Y), f(f(X, Y), f(f(f(Y, Y), f(Y, f(Y, Y))), f(f(Y, Y), f(Y, f(Y, Y)))))))
= { by lemma 24 }
  f(f(Y, f(Y, f(Y, Y))), f(f(X, Y), f(f(X, Y), f(f(f(Y, Y), f(Y, f(Y, Y))), f(f(Y, Y), f(Y, f(Y, Y)))))))
= { by lemma 23 }
  f(Y, f(f(X, Y), f(f(X, Y), f(f(f(Y, Y), f(Y, f(Y, Y))), f(f(Y, Y), f(Y, f(Y, Y)))))))
= { by lemma 24 }
  f(Y, f(f(X, Y), f(f(X, Y), f(f(Y, Y), f(Y, f(Y, Y))))))
= { by lemma 12 R->L }
  f(Y, f(f(X, Y), f(f(X, Y), f(f(V, Y), f(Y, f(Y, Y))))))
= { by lemma 20 }
  f(Y, f(f(X, Y), f(f(X, Y), f(Y, f(Y, f(Y, Y))))))
= { by lemma 23 }
  f(Y, f(f(X, Y), f(f(X, Y), Y)))
= { by lemma 22 }
  f(Y, f(f(X, Y), Y))
= { by lemma 22 }
  f(Y, Y)
= { by lemma 24 }
  Y

Goal 1 (goal): x = y.
Proof:
  x
= { by axiom 1 (hyp) }
  f(X, f(f(f(X, Y), x), f(x, f(f(x, X), f(Z, X)))))
= { by lemma 25 }
  f(f(f(X, Y), x), f(x, f(f(x, X), f(Z, X))))
= { by lemma 25 }
  f(x, f(f(x, X), f(Z, X)))
= { by lemma 25 }
  f(f(x, X), f(Z, X))
= { by lemma 25 }
  f(Z, X)
= { by lemma 25 R->L }
  f(f(y, X), f(Z, X))
= { by lemma 25 R->L }
  f(y, f(f(y, X), f(Z, X)))
= { by lemma 25 R->L }
  f(f(f(X, W), y), f(y, f(f(y, X), f(Z, X))))
= { by lemma 25 R->L }
  f(X, f(f(f(X, W), y), f(y, f(f(y, X), f(Z, X)))))
= { by axiom 1 (hyp) R->L }
  y
