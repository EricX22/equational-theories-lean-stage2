= { by lemma 22 R->L }
  f(f(f(f(X, f(X, X)), f(f(X, X), f(X, X))), X), f(f(f(X, f(f(f(f(f(X, X), X), f(f(X, X), Y)), X), f(f(X, f(f(f(X, X), X), f(f(X, X), Y))), X))), f(f(f(f(f(X, X), X), f(f(X, X), Y)), X), f(f(X, f(f(f(X, X), X), f(f(X, X), Y))), X))), f(f(f(X, X), X), f(f(X, X), Y))))
= { by lemma 2 R->L }
  f(f(f(X, f(f(X, X), Y)), f(f(f(X, X), X), f(f(X, X), Y))), f(f(f(X, f(f(f(f(f(X, X), X), f(f(X, X), Y)), X), f(f(X, f(f(f(X, X), X), f(f(X, X), Y))), X))), f(f(f(f(f(X, X), X), f(f(X, X), Y)), X), f(f(X, f(f(f(X, X), X), f(f(X, X), Y))), X))), f(f(f(X, X), X), f(f(X, X), Y))))
= { by lemma 33 R->L }
  f(f(f(f(f(f(f(X, X), X), f(f(X, X), Y)), X), f(f(X, f(f(f(X, X), X), f(f(X, X), Y))), X)), f(f(f(X, X), X), f(f(X, X), Y))), f(f(f(X, f(f(f(f(f(X, X), X), f(f(X, X), Y)), X), f(f(X, f(f(f(X, X), X), f(f(X, X), Y))), X))), f(f(f(f(f(X, X), X), f(f(X, X), Y)), X), f(f(X, f(f(f(X, X), X), f(f(X, X), Y))), X))), f(f(f(X, X), X), f(f(X, X), Y))))
= { by lemma 8 }
