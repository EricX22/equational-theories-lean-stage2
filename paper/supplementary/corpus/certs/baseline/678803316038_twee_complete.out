= { by lemma 30 R->L }
  f(f(X, f(f(f(X, f(X, f(X, X))), f(X, f(X, f(X, X)))), X)), f(f(f(f(f(X, f(X, f(X, X))), f(X, f(X, f(X, X)))), X), X), f(f(f(X, f(X, f(X, X))), f(X, f(X, f(X, X)))), X)))
= { by lemma 31 }
  f(f(f(X, f(f(X, f(X, f(X, X))), f(X, f(X, f(X, X))))), f(f(f(f(X, f(X, f(X, X))), f(X, f(X, f(X, X)))), X), f(f(X, f(X, f(X, X))), f(X, f(X, f(X, X)))))), X)
