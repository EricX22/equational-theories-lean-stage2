  f(f(f(X, Y), f(f(f(f(X, f(Y, Z)), f(f(Y, X), f(Y, Z))), X), f(f(f(X, f(Y, Z)), f(f(Y, X), f(Y, Z))), X))), X)
= { by axiom 1 (hyp) R->L }
  f(f(f(X, Y), f(f(f(f(X, f(Y, Z)), f(f(Y, X), f(Y, Z))), X), Y)), X)
= { by axiom 1 (hyp) R->L }
  f(f(f(X, Y), f(Y, Y)), X)

Lemma 3: f(f(f(f(X, Y), f(Y, Y)), X), X) = Y.
Proof:
  f(f(f(f(X, Y), f(Y, Y)), X), X)
= { by lemma 2 R->L }
  f(f(f(X, f(Y, Z)), f(f(Y, X), f(Y, Z))), X)
= { by axiom 1 (hyp) R->L }
  Y

Lemma 4: f(f(f(X, f(Y, Y)), f(f(f(Y, X), f(X, X)), Y)), f(f(f(Y, X), f(X, X)), Y)) = Y.
Proof:
  f(f(f(X, f(Y, Y)), f(f(f(Y, X), f(X, X)), Y)), f(f(f(Y, X), f(X, X)), Y))
= { by lemma 2 R->L }
  f(f(f(X, f(Y, Y)), f(f(Y, f(X, Z)), f(f(X, Y), f(X, Z)))), f(f(f(Y, X), f(X, X)), Y))
= { by lemma 2 R->L }
  f(f(f(X, f(Y, Y)), f(f(Y, f(X, Z)), f(f(X, Y), f(X, Z)))), f(f(Y, f(X, Z)), f(f(X, Y), f(X, Z))))
= { by axiom 1 (hyp) }
  f(f(f(f(f(f(Y, f(X, Z)), f(f(X, Y), f(X, Z))), Y), f(Y, Y)), f(f(Y, f(X, Z)), f(f(X, Y), f(X, Z)))), f(f(Y, f(X, Z)), f(f(X, Y), f(X, Z))))
= { by lemma 3 }
  Y

Lemma 5: f(f(f(X, Y), f(f(f(Z, f(f(Y, Z), W)), X), Y)), X) = f(Z, f(f(Y, Z), W)).
Proof:
  f(f(f(X, Y), f(f(f(Z, f(f(Y, Z), W)), X), Y)), X)
= { by axiom 1 (hyp) }
  f(f(f(X, Y), f(f(f(Z, f(f(Y, Z), W)), X), f(f(f(Z, f(Y, Z)), f(f(Y, Z), f(Y, Z))), Z))), X)
= { by axiom 1 (hyp) }
  f(f(f(X, f(f(f(Z, f(Y, Z)), f(f(Y, Z), f(Y, Z))), Z)), f(f(f(Z, f(f(Y, Z), W)), X), f(f(f(Z, f(Y, Z)), f(f(Y, Z), f(Y, Z))), Z))), X)
= { by lemma 2 R->L }
  f(f(f(X, f(f(f(Z, f(Y, Z)), f(f(Y, Z), f(Y, Z))), Z)), f(f(f(Z, f(f(Y, Z), W)), X), f(f(Z, f(f(Y, Z), W)), f(f(f(Y, Z), Z), f(f(Y, Z), W))))), X)
= { by lemma 2 R->L }
  f(f(f(X, f(f(Z, f(f(Y, Z), W)), f(f(f(Y, Z), Z), f(f(Y, Z), W)))), f(f(f(Z, f(f(Y, Z), W)), X), f(f(Z, f(f(Y, Z), W)), f(f(f(Y, Z), Z), f(f(Y, Z), W))))), X)
= { by axiom 1 (hyp) R->L }
  f(Z, f(f(Y, Z), W))

Lemma 6: f(f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), X), f(X, X)), f(f(f(X, Y), Y), f(f(X, Y), Z))) = f(Y, f(f(X, Y), Z)).
Proof:
  f(f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), X), f(X, X)), f(f(f(X, Y), Y), f(f(X, Y), Z)))
= { by axiom 1 (hyp) }
  f(f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), X), f(f(f(f(Y, f(X, Y)), f(f(X, Y), f(X, Y))), Y), X)), f(f(f(X, Y), Y), f(f(X, Y), Z)))
= { by lemma 2 R->L }
  f(f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), X), f(f(f(Y, f(f(X, Y), Z)), f(f(f(X, Y), Y), f(f(X, Y), Z))), X)), f(f(f(X, Y), Y), f(f(X, Y), Z)))
= { by lemma 5 }
  f(Y, f(f(X, Y), Z))

Lemma 7: f(f(f(X, f(f(f(Y, Z), f(Z, Z)), Y)), f(f(f(f(Y, Z), f(Z, Z)), Y), f(f(f(Y, Z), f(Z, Z)), Y))), X) = f(f(X, Z), f(f(f(f(f(Y, Z), f(Z, Z)), Y), X), Z)).
Proof:
  f(f(f(X, f(f(f(Y, Z), f(Z, Z)), Y)), f(f(f(f(Y, Z), f(Z, Z)), Y), f(f(f(Y, Z), f(Z, Z)), Y))), X)
= { by lemma 2 R->L }
  f(f(f(X, f(f(Y, f(Z, W)), f(f(Z, Y), f(Z, W)))), f(f(f(f(Y, Z), f(Z, Z)), Y), f(f(f(Y, Z), f(Z, Z)), Y))), X)
= { by lemma 2 R->L }
  f(f(f(X, f(f(Y, f(Z, W)), f(f(Z, Y), f(Z, W)))), f(f(f(Y, f(Z, W)), f(f(Z, Y), f(Z, W))), f(f(f(Y, Z), f(Z, Z)), Y))), X)
= { by lemma 2 R->L }
  f(f(f(X, f(f(Y, f(Z, W)), f(f(Z, Y), f(Z, W)))), f(f(f(Y, f(Z, W)), f(f(Z, Y), f(Z, W))), f(f(Y, f(Z, W)), f(f(Z, Y), f(Z, W))))), X)
= { by lemma 2 R->L }
  f(f(X, f(f(f(Y, f(Z, W)), f(f(Z, Y), f(Z, W))), Y)), f(f(f(f(Y, f(Z, W)), f(f(Z, Y), f(Z, W))), X), f(f(f(Y, f(Z, W)), f(f(Z, Y), f(Z, W))), Y)))
= { by axiom 1 (hyp) R->L }
  f(f(X, Z), f(f(f(f(Y, f(Z, W)), f(f(Z, Y), f(Z, W))), X), f(f(f(Y, f(Z, W)), f(f(Z, Y), f(Z, W))), Y)))
= { by lemma 2 }
  f(f(X, Z), f(f(f(f(f(Y, Z), f(Z, Z)), Y), X), f(f(f(Y, f(Z, W)), f(f(Z, Y), f(Z, W))), Y)))
= { by lemma 2 }
  f(f(X, Z), f(f(f(f(f(Y, Z), f(Z, Z)), Y), X), f(f(f(f(Y, Z), f(Z, Z)), Y), Y)))
= { by lemma 3 }
  f(f(X, Z), f(f(f(f(f(Y, Z), f(Z, Z)), Y), X), Z))

Lemma 8: f(f(f(f(X, Y), Z), X), f(f(f(Y, f(f(X, Y), Z)), f(f(X, Y), Z)), X)) = Y.
Proof:
  f(f(f(f(X, Y), Z), X), f(f(f(Y, f(f(X, Y), Z)), f(f(X, Y), Z)), X))
= { by lemma 6 R->L }
  f(f(f(f(X, Y), Z), X), f(f(f(f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), X), f(X, X)), f(f(f(X, Y), Y), f(f(X, Y), Z))), f(f(X, Y), Z)), X))
= { by lemma 7 R->L }
  f(f(f(f(f(X, Y), Z), f(f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), X), f(X, X)), f(f(f(X, Y), Y), f(f(X, Y), Z)))), f(f(f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), X), f(X, X)), f(f(f(X, Y), Y), f(f(X, Y), Z))), f(f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), X), f(X, X)), f(f(f(X, Y), Y), f(f(X, Y), Z))))), f(f(X, Y), Z))
= { by lemma 6 }
  f(f(f(f(f(X, Y), Z), f(Y, f(f(X, Y), Z))), f(f(f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), X), f(X, X)), f(f(f(X, Y), Y), f(f(X, Y), Z))), f(f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), X), f(X, X)), f(f(f(X, Y), Y), f(f(X, Y), Z))))), f(f(X, Y), Z))
= { by lemma 6 }
  f(f(f(f(f(X, Y), Z), f(Y, f(f(X, Y), Z))), f(f(f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), X), f(X, X)), f(f(f(X, Y), Y), f(f(X, Y), Z))), f(Y, f(f(X, Y), Z)))), f(f(X, Y), Z))
= { by lemma 6 }
  f(f(f(f(f(X, Y), Z), f(Y, f(f(X, Y), Z))), f(f(Y, f(f(X, Y), Z)), f(Y, f(f(X, Y), Z)))), f(f(X, Y), Z))
= { by axiom 1 (hyp) R->L }
  Y

Lemma 9: f(f(X, f(X, f(X, X))), f(X, f(X, f(X, X)))) = f(f(X, X), f(X, X)).
Proof:
  f(f(X, f(X, f(X, X))), f(X, f(X, f(X, X))))
= { by axiom 1 (hyp) }
  f(f(f(f(f(X, f(X, X)), f(f(X, X), f(X, X))), X), f(X, f(X, X))), f(X, f(X, f(X, X))))
= { by lemma 4 R->L }
  f(f(f(f(f(X, f(X, X)), f(f(X, X), f(X, X))), X), f(X, f(X, X))), f(f(f(f(f(X, X), f(X, X)), f(f(f(X, f(X, X)), f(f(X, X), f(X, X))), X)), f(f(f(X, f(X, X)), f(f(X, X), f(X, X))), X)), f(X, f(X, X))))
= { by lemma 8 }
  f(f(X, X), f(X, X))

Lemma 10: f(f(f(f(X, X), f(X, X)), X), f(f(f(f(f(X, X), f(X, X)), X), f(f(X, X), f(X, X))), X)) = f(X, f(X, X)).
Proof:
  f(f(f(f(X, X), f(X, X)), X), f(f(f(f(f(X, X), f(X, X)), X), f(f(X, X), f(X, X))), X))
= { by lemma 2 R->L }
  f(f(f(f(X, X), f(X, X)), X), f(f(f(f(X, f(X, X)), f(f(X, X), f(X, X))), f(f(X, X), f(X, X))), X))
= { by lemma 9 R->L }
  f(f(f(f(X, X), f(X, X)), X), f(f(f(f(X, f(X, X)), f(f(X, f(X, f(X, X))), f(X, f(X, f(X, X))))), f(f(X, X), f(X, X))), X))
= { by lemma 9 R->L }
  f(f(f(f(X, X), f(X, X)), X), f(f(f(f(X, f(X, X)), f(f(X, f(X, f(X, X))), f(X, f(X, f(X, X))))), f(f(X, f(X, f(X, X))), f(X, f(X, f(X, X))))), X))
= { by lemma 9 R->L }
  f(f(f(f(X, f(X, f(X, X))), f(X, f(X, f(X, X)))), X), f(f(f(f(X, f(X, X)), f(f(X, f(X, f(X, X))), f(X, f(X, f(X, X))))), f(f(X, f(X, f(X, X))), f(X, f(X, f(X, X))))), X))
= { by lemma 8 }
  f(X, f(X, X))

Lemma 11: f(f(X, f(f(f(f(X, Y), Y), f(Y, f(f(X, Y), Z))), f(f(f(X, Y), Y), f(f(X, Y), Z)))), f(Y, f(f(X, Y), Z))) = f(f(X, Y), Y).
Proof:
  f(f(X, f(f(f(f(X, Y), Y), f(Y, f(f(X, Y), Z))), f(f(f(X, Y), Y), f(f(X, Y), Z)))), f(Y, f(f(X, Y), Z)))
= { by lemma 6 R->L }
  f(f(X, f(f(f(f(X, Y), Y), f(Y, f(f(X, Y), Z))), f(f(f(X, Y), Y), f(f(X, Y), Z)))), f(f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), X), f(X, X)), f(f(f(X, Y), Y), f(f(X, Y), Z))))
= { by lemma 6 R->L }
  f(f(X, f(f(f(f(X, Y), Y), f(f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), X), f(X, X)), f(f(f(X, Y), Y), f(f(X, Y), Z)))), f(f(f(X, Y), Y), f(f(X, Y), Z)))), f(f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), X), f(X, X)), f(f(f(X, Y), Y), f(f(X, Y), Z))))
= { by lemma 2 R->L }
  f(f(X, f(f(f(f(X, Y), Y), f(f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), X), f(X, X)), f(f(f(X, Y), Y), f(f(X, Y), Z)))), f(f(f(X, Y), Y), f(f(X, Y), Z)))), f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), f(X, W)), f(f(X, f(f(f(X, Y), Y), f(f(X, Y), Z))), f(X, W))))
= { by lemma 2 R->L }
  f(f(X, f(f(f(f(X, Y), Y), f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), f(X, W)), f(f(X, f(f(f(X, Y), Y), f(f(X, Y), Z))), f(X, W)))), f(f(f(X, Y), Y), f(f(X, Y), Z)))), f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), f(X, W)), f(f(X, f(f(f(X, Y), Y), f(f(X, Y), Z))), f(X, W))))
= { by axiom 1 (hyp) }
  f(f(f(f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), f(X, W)), f(f(X, f(f(f(X, Y), Y), f(f(X, Y), Z))), f(X, W))), f(f(f(X, Y), Y), f(f(X, Y), Z))), f(f(f(f(X, Y), Y), f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), f(X, W)), f(f(X, f(f(f(X, Y), Y), f(f(X, Y), Z))), f(X, W)))), f(f(f(X, Y), Y), f(f(X, Y), Z)))), f(f(f(f(f(X, Y), Y), f(f(X, Y), Z)), f(X, W)), f(f(X, f(f(f(X, Y), Y), f(f(X, Y), Z))), f(X, W))))
= { by axiom 1 (hyp) R->L }
  f(f(X, Y), Y)

Lemma 12: f(f(f(f(X, Y), Z), f(f(f(f(f(f(X, Y), Z), X), X), f(X, Y)), f(f(f(f(f(X, Y), Z), X), X), Y))), f(X, Y)) = f(f(f(f(X, Y), Z), X), X).
Proof:
  f(f(f(f(X, Y), Z), f(f(f(f(f(f(X, Y), Z), X), X), f(X, Y)), f(f(f(f(f(X, Y), Z), X), X), Y))), f(X, Y))
= { by lemma 8 R->L }
  f(f(f(f(X, Y), Z), f(f(f(f(f(f(X, Y), Z), X), X), f(X, Y)), f(f(f(f(f(X, Y), Z), X), X), f(f(f(f(X, Y), Z), X), f(f(f(Y, f(f(X, Y), Z)), f(f(X, Y), Z)), X))))), f(X, Y))
= { by lemma 8 R->L }
  f(f(f(f(X, Y), Z), f(f(f(f(f(f(X, Y), Z), X), X), f(X, Y)), f(f(f(f(f(X, Y), Z), X), X), f(f(f(f(X, Y), Z), X), f(f(f(Y, f(f(X, Y), Z)), f(f(X, Y), Z)), X))))), f(X, f(f(f(f(X, Y), Z), X), f(f(f(Y, f(f(X, Y), Z)), f(f(X, Y), Z)), X))))
= { by lemma 8 R->L }
  f(f(f(f(X, Y), Z), f(f(f(f(f(f(X, Y), Z), X), X), f(X, f(f(f(f(X, Y), Z), X), f(f(f(Y, f(f(X, Y), Z)), f(f(X, Y), Z)), X)))), f(f(f(f(f(X, Y), Z), X), X), f(f(f(f(X, Y), Z), X), f(f(f(Y, f(f(X, Y), Z)), f(f(X, Y), Z)), X))))), f(X, f(f(f(f(X, Y), Z), X), f(f(f(Y, f(f(X, Y), Z)), f(f(X, Y), Z)), X))))
= { by lemma 11 }
  f(f(f(f(X, Y), Z), X), X)

Lemma 13: f(f(f(X, f(f(f(Y, Z), W), Y)), f(f(f(f(Y, Z), W), Y), f(f(f(Y, Z), W), Y))), X) = f(f(X, Z), f(f(f(f(f(Y, Z), W), Y), X), Z)).
Proof:
  f(f(f(X, f(f(f(Y, Z), W), Y)), f(f(f(f(Y, Z), W), Y), f(f(f(Y, Z), W), Y))), X)
= { by lemma 2 R->L }
  f(f(X, f(f(f(f(Y, Z), W), Y), f(f(f(Z, f(f(Y, Z), W)), f(f(Y, Z), W)), Y))), f(f(f(f(f(Y, Z), W), Y), X), f(f(f(f(Y, Z), W), Y), f(f(f(Z, f(f(Y, Z), W)), f(f(Y, Z), W)), Y))))
= { by lemma 8 }
  f(f(X, Z), f(f(f(f(f(Y, Z), W), Y), X), f(f(f(f(Y, Z), W), Y), f(f(f(Z, f(f(Y, Z), W)), f(f(Y, Z), W)), Y))))
= { by lemma 8 }
  f(f(X, Z), f(f(f(f(f(Y, Z), W), Y), X), Z))

Lemma 14: f(f(X, Y), f(f(f(f(f(f(X, Z), Y), X), X), X), Y)) = f(f(f(X, Z), Y), X).
Proof:
  f(f(X, Y), f(f(f(f(f(f(X, Z), Y), X), X), X), Y))
= { by lemma 12 R->L }
  f(f(X, Y), f(f(f(f(f(f(X, Z), Y), f(f(f(f(f(f(X, Z), Y), X), X), f(X, Z)), f(f(f(f(f(X, Z), Y), X), X), Z))), f(X, Z)), X), Y))
= { by lemma 13 R->L }
  f(f(f(X, f(f(f(f(X, Z), Y), f(f(f(f(f(f(X, Z), Y), X), X), f(X, Z)), f(f(f(f(f(X, Z), Y), X), X), Z))), f(X, Z))), f(f(f(f(f(X, Z), Y), f(f(f(f(f(f(X, Z), Y), X), X), f(X, Z)), f(f(f(f(f(X, Z), Y), X), X), Z))), f(X, Z)), f(f(f(f(X, Z), Y), f(f(f(f(f(f(X, Z), Y), X), X), f(X, Z)), f(f(f(f(f(X, Z), Y), X), X), Z))), f(X, Z)))), X)
= { by lemma 12 }
  f(f(f(X, f(f(f(f(X, Z), Y), X), X)), f(f(f(f(f(X, Z), Y), f(f(f(f(f(f(X, Z), Y), X), X), f(X, Z)), f(f(f(f(f(X, Z), Y), X), X), Z))), f(X, Z)), f(f(f(f(X, Z), Y), f(f(f(f(f(f(X, Z), Y), X), X), f(X, Z)), f(f(f(f(f(X, Z), Y), X), X), Z))), f(X, Z)))), X)
= { by lemma 12 }
  f(f(f(X, f(f(f(f(X, Z), Y), X), X)), f(f(f(f(f(X, Z), Y), f(f(f(f(f(f(X, Z), Y), X), X), f(X, Z)), f(f(f(f(f(X, Z), Y), X), X), Z))), f(X, Z)), f(f(f(f(X, Z), Y), X), X))), X)
= { by lemma 12 }
  f(f(f(X, f(f(f(f(X, Z), Y), X), X)), f(f(f(f(f(X, Z), Y), X), X), f(f(f(f(X, Z), Y), X), X))), X)
= { by axiom 1 (hyp) R->L }
  f(f(f(X, Z), Y), X)

Lemma 15: f(f(f(f(f(X, Y), Z), X), X), f(f(f(Z, f(f(f(X, Y), Z), X)), f(f(f(X, Y), Z), X)), X)) = Z.
Proof:
  f(f(f(f(f(X, Y), Z), X), X), f(f(f(Z, f(f(f(X, Y), Z), X)), f(f(f(X, Y), Z), X)), X))
= { by lemma 14 R->L }
  f(f(f(f(f(X, Y), Z), X), X), f(f(f(Z, f(f(X, Z), f(f(f(f(f(f(X, Y), Z), X), X), X), Z))), f(f(f(X, Y), Z), X)), X))
= { by lemma 14 R->L }
  f(f(f(f(f(X, Y), Z), X), X), f(f(f(Z, f(f(X, Z), f(f(f(f(f(f(X, Y), Z), X), X), X), Z))), f(f(X, Z), f(f(f(f(f(f(X, Y), Z), X), X), X), Z))), X))
= { by lemma 14 R->L }
  f(f(f(f(X, Z), f(f(f(f(f(f(X, Y), Z), X), X), X), Z)), X), f(f(f(Z, f(f(X, Z), f(f(f(f(f(f(X, Y), Z), X), X), X), Z))), f(f(X, Z), f(f(f(f(f(f(X, Y), Z), X), X), X), Z))), X))
= { by lemma 8 }
  Z

Lemma 16: f(f(X, f(f(f(X, X), f(X, X)), X)), f(f(X, X), f(f(f(X, X), f(X, X)), X))) = f(f(f(X, X), f(X, X)), X).
Proof:
