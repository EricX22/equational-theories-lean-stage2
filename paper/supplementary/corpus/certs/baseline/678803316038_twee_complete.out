= { by lemma 4 }
  f(f(f(f(f(Y, X), f(X, X)), Y), Y), f(f(f(f(f(X, f(Y, Y)), f(f(f(Y, X), f(X, X)), Y)), f(f(f(Y, X), f(X, X)), Y)), f(f(f(Y, X), f(X, X)), Y)), f(f(f(X, f(Y, Y)), f(f(f(Y, X), f(X, X)), Y)), f(f(f(Y, X), f(X, X)), Y))))
= { by lemma 4 }
  f(f(f(f(f(Y, X), f(X, X)), Y), Y), f(f(f(f(f(X, f(Y, Y)), f(f(f(Y, X), f(X, X)), Y)), f(f(f(Y, X), f(X, X)), Y)), f(f(f(Y, X), f(X, X)), Y)), Y))
