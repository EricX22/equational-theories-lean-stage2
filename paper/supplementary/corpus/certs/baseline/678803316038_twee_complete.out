Lemma 27: f(f(f(X, X), f(f(X, X), X)), X) = X.
Proof:
  f(f(f(X, X), f(f(X, X), X)), X)
= { by lemma 18 R->L }
  f(f(f(X, X), f(f(X, X), X)), f(f(X, f(X, X)), f(f(f(X, X), X), f(X, X))))
= { by lemma 22 R->L }
  f(f(f(X, X), f(f(X, X), X)), f(f(f(X, f(X, X)), f(f(X, X), f(X, X))), X))
= { by lemma 23 R->L }
  f(f(f(X, X), f(f(X, X), X)), f(f(f(X, f(f(X, X), f(X, X))), f(f(X, X), f(X, X))), X))
= { by lemma 18 R->L }
  f(f(f(X, X), f(f(X, f(f(X, f(X, X)), f(f(f(X, X), X), f(X, X)))), X)), f(f(f(X, f(f(X, X), f(X, X))), f(f(X, X), f(X, X))), X))
= { by lemma 18 R->L }
  f(f(f(X, X), f(f(X, f(f(X, f(X, X)), f(f(f(X, X), X), f(X, X)))), X)), f(f(f(X, f(f(X, X), f(X, X))), f(f(X, X), f(X, X))), f(f(X, f(X, X)), f(f(f(X, X), X), f(X, X)))))
= { by lemma 22 R->L }
  f(f(f(X, X), f(f(X, f(f(f(X, f(X, X)), f(f(X, X), f(X, X))), X)), X)), f(f(f(X, f(f(X, X), f(X, X))), f(f(X, X), f(X, X))), f(f(X, f(X, X)), f(f(f(X, X), X), f(X, X)))))
= { by lemma 22 R->L }
  f(f(f(X, X), f(f(X, f(f(f(X, f(X, X)), f(f(X, X), f(X, X))), X)), X)), f(f(f(X, f(f(X, X), f(X, X))), f(f(X, X), f(X, X))), f(f(f(X, f(X, X)), f(f(X, X), f(X, X))), X)))
= { by lemma 25 R->L }
  f(f(f(f(X, X), f(X, X)), f(f(f(X, f(X, X)), f(f(X, X), f(X, X))), X)), f(f(f(X, f(f(X, X), f(X, X))), f(f(X, X), f(X, X))), f(f(f(X, f(X, X)), f(f(X, X), f(X, X))), X)))
