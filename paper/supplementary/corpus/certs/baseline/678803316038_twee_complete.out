  f(f(f(f(X, f(f(X, X), f(f(X, X), X))), X), f(f(f(f(X, f(f(f(X, X), f(X, X)), X)), f(f(f(f(X, X), f(X, X)), X), f(f(X, f(X, Y)), f(f(X, X), f(X, Y))))), X), X)), f(X, f(f(X, X), f(f(X, X), X))))
